{
  "name": "tracemiku-agent",
  "version": "5.0.0",
  "private": true,
  "description": "traceMiku Frida agent \u2014 ARM64 instruction-level trace",
  "main": "_agent.js",
  "scripts": {
    "build": "node ./node_modules/frida-compile/dist/cli.js src/agent.ts -o _agent.js -c",
    "watch": "node ./node_modules/frida-compile/dist/cli.js src/agent.ts -o _agent.js -w",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "devDependencies": {
    "@types/frida-gum": "^18.7.1",
    "frida-compile": "^19.0.5",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "frida@17.9.10": true
  }
}