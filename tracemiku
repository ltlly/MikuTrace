    q_cv.add_argument("--fn", dest="fn_name", help="直接按函数名 (如 sub_7f10)")

    # list
    p_ls = sp.add_parser("list", help="列出已有 trace (无参=列 runs, <run>=列 calls 降序)")
    p_ls.add_argument("path", nargs="?", help="可选: 某 run 目录, 列出其中的 calls (records 降序)")
    p_ls.add_argument("--dir", help="trace 根目录 (默认 traces/)")
    p_ls.add_argument("--json", action="store_true")

    # info
    p_in = sp.add_parser("info", help="trace 元信息")
    p_in.add_argument("path", help="trace 目录")
    p_in.add_argument("--json", action="store_true")

    # finalize (recover _pending_call_*)
    p_fz = sp.add_parser("finalize", help="扫 run/calls/_pending_call_* 补 meta + 重命名 (恢复中断的 trace)")
    p_fz.add_argument("path", help="run 目录")

    # dec (Rust v2 decompiler facade)
    p_dc = sp.add_parser("dec",
                         help="Rust v2 反编译 markdown facade")
    p_dc.add_argument("path", help="trace 目录 (per-call 或 single-bin)")
    p_dc.add_argument("--fn", default=None,
                      help="只输出指定 fn id (e.g. F0) 到 stdout, 不落盘")
    p_dc.add_argument("--summary", action="store_true",
                      help="只输出 summary.md 到 stdout, 不落盘")
    p_dc.add_argument("--out", default=None,
                      help="输出根 (默认 = path/decompile)")
    p_dc.add_argument("--tier", default="hot",
                      choices=("full", "hot", "summary"),
                      help="block 渲染粒度: full=全部 asm; hot=top exec_count + 冷块 stub "
                           "(默认, 单 fn 通常 < 60KB 适合 LLM); summary=只 fn 概要")

    # crypto
    p_crypto = sp.add_parser("crypto", help="Combined crypto analysis (constant scan + ARM CE detection)")
    p_crypto.add_argument("call_dir", help="Per-call trace directory")

    # watchpoints
    p_watch = sp.add_parser("watch", help="Trace watchpoint scan (reg-change/reg-equals/mem-touch)")
    p_watch.add_argument("call_dir", help="Per-call trace directory")
    p_watch.add_argument("--kind", default="reg-change", choices=("reg-change", "reg-equals", "mem-touch"))
    p_watch.add_argument("--reg", default=None)
    p_watch.add_argument("--addr", default=None)
    p_watch.add_argument("--value", default=None)
    p_watch.add_argument("--size", type=int, default=1)
    p_watch.add_argument("--cursor", type=int, default=0)
    p_watch.add_argument("--limit", type=int, default=200)

    # web (single-page IDA-style SPA, 推荐替代 view)
    p_web = sp.add_parser("web", help="Rust v2 Solid SPA")
    p_web.add_argument("path", help="trace 目录 (run 或 per-call)")
    p_web.add_argument("--host", default="0.0.0.0")
    p_web.add_argument("--port", type=int, default=18900)
    p_web.add_argument("--no-browser", action="store_true", help="不自动打开浏览器")
    p_web.add_argument("--so", default=None,
                       help="SO 文件路径 (启用 HLIL 反编译 tab; 启动时后台加载)")
    p_web.add_argument("--decomp", default=None,
                       choices=("binja", "ghidra", "none"),
                       help="deprecated; BN uses TRACEMIKU_BN_SO / --so in Rust v2")

    # doctor (pre-flight device check)
    p_doc = sp.add_parser("doctor", help="检查设备 trace 前置条件 (adb/root/frida/SELinux)")
    p_doc.add_argument("--pkg", default=None, help="目标 app 包名 (检查是否安装)")
    p_doc.add_argument("--out", default=None, help="trace 输出目录 (检查是否可写)")

    # probe (lightweight Interceptor-only counting, no Stalker)
    p_pb = sp.add_parser("probe",
                         help="轻量级 Interceptor 导出函数计数 (不启动 Stalker, 无 trace.bin)")
    p_pb.add_argument("--pkg", default=None, help="目标 app 包名 (进程名子串)")
    p_pb.add_argument("--attach-pid", type=int, default=None, help="直接附加 pid")
    p_pb.add_argument("--so", required=True, help="目标 SO 名子串")
    p_pb.add_argument("--filter", default=None,
                      help="导出函数名过滤子串 (只 hook 包含该子串的导出)")
    p_pb.add_argument("--duration", type=int, default=10,
                      help="采集时长秒数 (默认 10)")
    p_pb.add_argument("--top", type=int, default=30,
                      help="只显示 top N 调用频次最高的 (默认 30)")
    p_pb.add_argument("--remote", default=None,
                      help="frida-server TCP 地址. 不传则走 USB")
    p_pb.add_argument("--json", action="store_true",
                      help="额外输出完整 JSON 结果")

    args = ap.parse_args()
    if args.subcommand == "trace":   return cmd_trace(args)
    if args.subcommand == "view":    return cmd_view(args)
    if args.subcommand == "api":     return cmd_api(args)
    if args.subcommand == "query":   return cmd_query(args)
    if args.subcommand == "list":    return cmd_list(args)
    if args.subcommand == "info":    return cmd_info(args)
    if args.subcommand == "finalize":return cmd_finalize(args)
    if args.subcommand == "web":     return cmd_web(args)
    if args.subcommand == "crypto":  return _run_rust_cli(["crypto", args.call_dir])
    if args.subcommand == "watch":
        cmd = ["watch", args.call_dir, "--kind", args.kind, "--size", str(args.size),
               "--cursor", str(args.cursor), "--limit", str(args.limit)]
        if args.reg: cmd += ["--reg", args.reg]
        if args.addr: cmd += ["--addr", args.addr]
        if args.value: cmd += ["--value", args.value]
        return _run_rust_cli(cmd)
    if args.subcommand == "dec":     return cmd_dec(args)
    if args.subcommand == "probe":   return cmd_probe(args)
    if args.subcommand == "doctor":  return cmd_doctor(args)
    ap.print_help(); return 1


if __name__ == "__main__":
    sys.exit(main())
