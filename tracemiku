#!/usr/bin/env python3
"""tracemiku — 安卓真机 ARM64 指令级 trace 全栈工具.

子命令:
  trace    采集 trace (任意 app 任意 SO 任意函数)
  view     启动 TUI 查看器
  query    AI 友好的 JSON 查询接口 (供 Claude Code 等调用)
  list     列出已有 trace
  info     trace 元信息

示例:
  tracemiku trace --pkg com.taobao.taobao --so libsgmainso \\
    --method doCommandNative --cmd 70102 --duration 90 --out traces/run1
  tracemiku view traces/run1
  tracemiku query traces/run1 records --range 0..50 --regs x0,x1,x2 --json
  tracemiku query traces/run1 forward-taint --from 0 --reg x2 --json
  tracemiku query traces/run1 strings --json
"""
import sys, os, pathlib, argparse, json, subprocess, time

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))


def _cold_launch(pkg, max_wait=60):
    """force-stop + pm clear + monkey 启动 + 自动点 '同意' + 等首页. 失败 raise."""
    import re, time
    def adb(*a, capture=True):
        return subprocess.run(["adb","shell",*a], capture_output=capture, text=True).stdout
    print(f"[cold-launch] force-stop + pm clear {pkg}", flush=True)
    subprocess.run(["adb","shell","am","force-stop",pkg], capture_output=True)
    subprocess.run(["adb","shell","pm","clear",pkg], capture_output=True)
    time.sleep(2)
    print(f"[cold-launch] monkey 拉起", flush=True)
    subprocess.run(["adb","shell","monkey","-p",pkg,"-c","android.intent.category.LAUNCHER","1"],
                   capture_output=True)
    t0 = time.time(); agreed = False
    while time.time() - t0 < max_wait:
        elapsed = int(time.time() - t0)
        pid = adb("pidof", pkg).strip()
        if not pid:
            print(f"[cold-launch] {elapsed}s: 进程死, 重拉", flush=True)
            subprocess.run(["adb","shell","monkey","-p",pkg,"-c","android.intent.category.LAUNCHER","1"],
                           capture_output=True)
            time.sleep(3); continue
        subprocess.run(["adb","shell","uiautomator","dump","/sdcard/_tb_ui.xml"],
                       capture_output=True)
        xml = adb("cat","/sdcard/_tb_ui.xml")
        if not agreed:
            # 优先精确匹配 text="同意" (排除 "不同意")
            m = re.search(r'text="同意"[^>]*?bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"', xml)
            if m:
                x = (int(m.group(1)) + int(m.group(3))) // 2
                y = (int(m.group(2)) + int(m.group(4))) // 2
                print(f"[cold-launch] {elapsed}s: 找到同意按钮 @ ({x},{y}) 点击", flush=True)
                subprocess.run(["adb","shell","input","tap",str(x),str(y)], capture_output=True)
                agreed = True; time.sleep(4); continue
        # 主界面标志: 推荐/首页/淘宝直播 等
        if re.search(r'推荐|首页|淘宝直播|百亿补贴', xml):
            print(f"[cold-launch] {elapsed}s: 首页加载完成 (agreed={agreed})", flush=True)
            return int(pid)
        print(f"[cold-launch] {elapsed}s: 等待 (agreed={agreed})", flush=True)
        time.sleep(2)
    raise RuntimeError(f"cold-launch {pkg} 超时 {max_wait}s")


def cmd_trace(args):
    """spawn frida agent, save trace."""
    import frida, signal
    if getattr(args, "cold_launch", False) and args.pkg:
        try: _cold_launch(args.pkg)
        except Exception as e: print(f"[!] cold-launch 失败: {e}"); return 2
    # 选择 agent 文件 (按 --mode)
    agent_map = {
        "js":      "agent_generic.js",       # 旧 JS callout, 30K rec/s
        "cmodule": "agent_cmodule_v3.js",    # CModule 极速 native callout
    }
    agent_name = agent_map.get(args.mode, "agent_generic.js")
    AGENT_PATH = HERE / "tracer" / agent_name
    AGENT = AGENT_PATH.read_text()
    print(f"[host] using agent: {agent_name} (mode={args.mode})", flush=True)

    OUT = pathlib.Path(args.out); OUT.mkdir(parents=True, exist_ok=True)
    log_fp = open(OUT/"log.txt", "w")
    sess_files = {}
    top_meta = {
        "pkg": args.pkg, "so": args.so,
        "method": args.method, "export": args.export,
        "fn_offset": args.fn_offset, "cmd": args.cmd,
        "started_at": time.time(), "sessions": [],
        "tracemiku_cli": True,
    }

    def wlog(s):
        line = f"[{time.strftime('%H:%M:%S')}] {s}"
        print(line, flush=True); log_fp.write(line + "\n"); log_fp.flush()

    def open_sess(pid, tid):
        key = (pid, tid)
        if key in sess_files: return sess_files[key]
        fp = open(OUT/f"trace_{pid}_{tid}.bin", "wb")
        md = {"pid": pid, "tid": tid, "started_at": time.time(),
              "frames": 0, "bytes": 0}
        sess_files[key] = {"fp": fp, "meta": md}
        top_meta["sessions"].append([pid, tid])
        return sess_files[key]

    def make_cb(pid, tag):
        def cb(m, data):
            if m["type"] == "send":
                p = m["payload"]
                if isinstance(p, dict):
                    t = p.get("type")
                    if t == "log": wlog(f"[{tag}] {p['msg']}")
                    elif t == "frames":
                        tid = p.get("tid", 0)
                        s = open_sess(pid, tid)
                        if data: s["fp"].write(data); s["fp"].flush()
                        s["meta"]["bytes"] += len(data) if data else 0
                        s["meta"]["frames"] += p["recs"]
                        wlog(f"[{tag}] tid={tid} +{p['recs']} (total={p['total']}, {p.get('reason','?')})")
                    elif t == "module":
                        for s in sess_files.values(): s["meta"]["module"] = {k: p[k] for k in ("name","base","size")}
                        if "module" not in top_meta:
                            top_meta["module"] = {k: p[k] for k in ("name","base","size")}
                        wlog(f"[{tag}] 模块 {p['name']} @ {p['base']}")
                    elif t == "fn-resolved":
                        top_meta["fn_addr"] = p["addr"]
                        wlog(f"[{tag}] 函数 @ {p['addr']}")
                    elif t == "register-native":
                        top_meta["registration"] = {k: p[k] for k in ("name","sig","fp")}
                        wlog(f"[{tag}] 动态注册 {p['name']} {p['sig']} → {p['fp']}")
                    elif t == "trace-begin":
                        open_sess(pid, p["tid"])
                        sess_files[(pid, p["tid"])]["meta"]["trace_begin"] = {"tid": p["tid"], "ts": p["ts"]}
                        wlog(f"[{tag}] trace 开始 tid={p['tid']}")
                    elif t == "trace-end":
                        if (pid, p["tid"]) in sess_files:
                            sess_files[(pid, p["tid"])]["meta"]["trace_end"] = {"retval": p.get("retval"), "ms": p.get("ms")}
                        wlog(f"[{tag}] trace 结束 tid={p['tid']} ms={p.get('ms')} ret={p.get('retval')}")
                    elif t == "follow": wlog(f"[{tag}] 跟踪 tid={p['tid']} ({p.get('label','?')})")
                    elif t == "cmd-hist":
                        h = p.get("hist", {})
                        top = sorted(h.items(), key=lambda kv: -kv[1])[:8]
                        wlog(f"[{tag}] cmd 直方图 总数={p['total']} top: " + " ".join(f"{k}:{v}" for k,v in top))
                    elif t == "hb":
                        wlog(f"[{tag}] HB head={p['head']} total={p['total']} dropped={p['dropped']} fnEntered={p['fnEntered']}")
                    elif t == "hello":
                        wlog(f"[{tag}] agent 启动 frida={p['frida']}")
                    else:
                        wlog(f"[{tag}] {json.dumps(p, ensure_ascii=False)}")
                else: wlog(f"[{tag}] {p}")
            elif m["type"] == "error":
                wlog(f"[{tag}] 错误 {m.get('description')}")
                if "stack" in m: wlog(m["stack"])
        return cb

    mgr = frida.get_device_manager()
    if args.remote:
        device = mgr.add_remote_device(args.remote)
    else:
        device = frida.get_usb_device(timeout=10)
    wlog(f"device={device}")

    AGENT_OPTS = {
        "soPattern": args.so,
        "methodName": args.method,
        "exportName": args.export,
        "fnOffset": int(args.fn_offset, 16) if args.fn_offset else None,
        "cmdArg": args.cmd_arg,
        "cmdValue": args.cmd or 0,
        "maxRecords": args.max_records,
        "followAllThreads": args.follow_workers,
    }
    wlog(f"agent opts: {AGENT_OPTS}")

    pid = None
    if args.attach_pid:
        pid = args.attach_pid
    elif args.pkg:
        for p in device.enumerate_processes():
            if p.name == args.pkg: pid = p.pid; break
        if pid is None:
            r = subprocess.run(["adb","shell","pidof",args.pkg], capture_output=True, text=True)
            if r.stdout.strip(): pid = int(r.stdout.strip().split()[0])
    if pid is None:
        wlog(f"[!] 找不到目标进程 (pkg={args.pkg}); 先启动 app 或 --attach-pid <pid>")
        log_fp.close(); return 1
    wlog(f"attach pid={pid}")
    sess = device.attach(pid)
    scr = sess.create_script(AGENT)
    scr.on("message", make_cb(pid, args.pkg or f"pid{pid}"))
    scr.load()
    r = scr.exports_sync.init(AGENT_OPTS)
    wlog(f"init -> {r}")

    stop = [False]
    signal.signal(signal.SIGINT, lambda *_: stop.__setitem__(0, True))
    t0 = time.time()
    while not stop[0] and time.time() - t0 < args.duration:
        time.sleep(0.5)

    wlog("teardown")
    try: print(f"stats:", scr.exports_sync.stats(), flush=True)
    except: pass
    try: scr.exports_sync.force_flush()
    except: pass
    try: scr.unload()
    except: pass
    try: sess.detach()
    except: pass

    for key, s in sess_files.items():
        try: s["fp"].close()
        except: pass
        s["meta"]["closed_at"] = time.time()
        json.dump(s["meta"], open(OUT/f"meta_{key[0]}_{key[1]}.json","w"), indent=2)
    top_meta["stopped_at"] = time.time()
    json.dump(top_meta, open(OUT/"meta.json","w"), indent=2)
    log_fp.close()

    total_b = sum(s["meta"]["bytes"] for s in sess_files.values())
    print(f"\n[完成] {len(sess_files)} 个 session, 共 {total_b} 字节 ({total_b//272} 条记录)")
    for key, s in sorted(sess_files.items(), key=lambda kv: -kv[1]["meta"]["bytes"])[:10]:
        if s["meta"]["bytes"] > 0:
            print(f"  trace_{key[0]}_{key[1]}.bin: {s['meta']['bytes']} 字节 ({s['meta']['frames']} 条)")
    return 0


def cmd_view(args):
    from viewer.app import TraceMikuApp
    app = TraceMikuApp(args.path); app.run(); return 0


def cmd_list(args):
    base = pathlib.Path(args.dir or "traces")
    if not base.exists():
        print(f"[!] 目录不存在: {base}"); return 1
    rows = []
    for sub in sorted(base.iterdir()):
        if not sub.is_dir(): continue
        meta_f = sub/"meta.json"
        meta = json.load(open(meta_f)) if meta_f.exists() else {}
        bins = list(sub.glob("trace_*.bin"))
        total = sum(b.stat().st_size for b in bins)
        rows.append({
            "name": sub.name, "method": meta.get("method"), "cmd": meta.get("cmd"),
            "sessions": len(bins), "bytes": total, "records": total//272,
        })
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
    else:
        print(f"{'name':<40s}  {'method':<20s}  cmd       sessions  records")
        for r in rows:
            print(f"{r['name']:<40s}  {str(r['method'] or '-'):<20s}  "
                  f"{str(r['cmd'] or '-'):>5s}     {r['sessions']:>3d}      {r['records']:>9d}")
    return 0


def cmd_info(args):
    from viewer.trace import load
    t = load(args.path)
    out = {
        "path": str(args.path),
        "records": len(t),
        "module": {"name": t.meta.module.name, "base": hex(t.meta.module.base),
                   "size": t.meta.module.size} if t.meta.module else None,
        "method": t.meta.method, "cmd": t.meta.cmd,
        "fn_addr": hex(t.meta.fn_addr) if t.meta.fn_addr else None,
    }
    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
    else:
        for k, v in out.items(): print(f"{k}: {v}")
    return 0


def cmd_query(args):
    """AI 友好的 JSON 查询子命令."""
    from viewer.trace import load, REG_NAMES, ALL_REGS
    from viewer.disasm import decode
    from viewer.index import Index
    from viewer.symbols import build_from_trace
    from viewer.memshadow import MemShadow
    t = load(args.path)
    sym = build_from_trace(t)
    base = t.meta.module.base if t.meta.module else 0
    end = base + t.meta.module.size if t.meta.module else 0

    out = None
    sub = args.sub
    if sub == "records":
        # 输出指定范围的记录
        a, b = (0, len(t))
        if args.range:
            a_, b_ = args.range.split("..")
            a = int(a_) if a_ else 0
            b = int(b_) if b_ else len(t)
        regs_filter = args.regs.split(",") if args.regs else None
        rows = []
        for i in range(a, min(b, len(t))):
            r = t.record(i); d = decode(r.pc, r.inst)
            fname, foff = sym.lookup(r.pc)
            row = {
                "idx": i, "pc": hex(r.pc), "rel": hex(r.pc - base) if base else None,
                "func": fname if fname != "?" else None,
                "off": hex(foff) if fname != "?" else None,
                "asm": f"{d.mnemonic} {d.op_str}",
                "is_branch": d.is_branch, "is_call": d.is_call, "is_ret": d.is_ret,
            }
            if regs_filter:
                row["regs"] = {nm: hex(r.reg(nm)) for nm in regs_filter if nm in ALL_REGS}
            rows.append(row)
        out = {"count": len(rows), "records": rows}
    elif sub == "forward-taint":
        from viewer.taint import forward_taint
        idx = Index(t); idx.build()
        results = forward_taint(t, args.from_, args.reg, max_count=args.max)
        rows = []
        for i, why in results:
            r = t.record(i); d = decode(r.pc, r.inst)
            fname, foff = sym.lookup(r.pc)
            rows.append({"idx": i, "pc": hex(r.pc),
                         "func": fname if fname != "?" else None,
                         "off": hex(foff) if fname != "?" else None,
                         "asm": f"{d.mnemonic} {d.op_str}", "why": why})
        out = {"count": len(rows), "from": args.from_, "reg": args.reg, "hits": rows}
    elif sub == "backward-taint":
        from viewer.taint import backward_taint
        idx = Index(t); idx.build()
        results = backward_taint(t, args.from_, args.reg, max_count=args.max)
        rows = []
        for i, reg in results:
            r = t.record(i); d = decode(r.pc, r.inst)
            fname, foff = sym.lookup(r.pc)
            rows.append({"idx": i, "pc": hex(r.pc),
                         "func": fname if fname != "?" else None,
                         "off": hex(foff) if fname != "?" else None,
                         "asm": f"{d.mnemonic} {d.op_str}", "via": reg})
        out = {"count": len(rows), "from": args.from_, "reg": args.reg, "chain": rows}
    elif sub == "strings":
        mem = MemShadow(t); mem.build()
        results = mem.find_strings(min_len=args.min_len)
        rows = [{"addr": hex(a), "len": len(s), "str": s} for a, s in results]
        out = {"count": len(rows), "strings": rows}
    elif sub == "cfg":
        from viewer.cfg import build_cfg
        cfg = build_cfg(t, only_module=True)
        blocks = []
        for pc, b in cfg.blocks.items():
            blocks.append({
                "start": hex(pc), "end": hex(b.end_pc), "off": hex(pc-base) if base else None,
                "insns": len(b.insns), "executions": b.executions,
                "exits": [{"to": hex(t), "kind": k} for t,k in b.exits],
            })
        edges = [{"src": hex(s), "dst": hex(d), "kind": v["kind"], "count": v["count"]}
                 for (s,d), v in cfg.edges.items()]
        out = {"blocks": blocks, "edges": edges,
               "block_count": len(blocks), "edge_count": len(edges),
               "entry": hex(cfg.entry_pc)}
    elif sub == "search":
        import re
        rx = re.compile(args.pattern, re.I)
        rows = []
        for i in range(len(t)):
            r = t.record(i); d = decode(r.pc, r.inst)
            if rx.search(f"{d.mnemonic} {d.op_str}"):
                fname, foff = sym.lookup(r.pc)
                rows.append({"idx": i, "pc": hex(r.pc),
                             "func": fname if fname != "?" else None,
                             "off": hex(foff) if fname != "?" else None,
                             "asm": f"{d.mnemonic} {d.op_str}"})
                if len(rows) >= args.max: break
        out = {"count": len(rows), "pattern": args.pattern, "hits": rows}
    elif sub == "func-summary":
        # 列出 trace 里出现的所有函数
        funcs = {}
        for i in range(len(t)):
            r = t.record(i)
            fname, foff = sym.lookup(r.pc)
            if fname not in funcs:
                funcs[fname] = {"count": 0, "first_idx": i, "last_idx": i}
            funcs[fname]["count"] += 1
            funcs[fname]["last_idx"] = i
        rows = sorted([{"func": k, **v} for k, v in funcs.items()],
                      key=lambda r: -r["count"])
        out = {"functions": rows}

    if out is not None:
        if args.json:
            print(json.dumps(out, ensure_ascii=False, indent=2))
        else:
            # 简单纯文本输出
            if sub == "records":
                for r in out["records"]:
                    print(f"#{r['idx']:6d}  {r.get('func',''):<24s}+{r.get('off','')}  {r['asm']}")
            elif sub in ("forward-taint", "backward-taint"):
                key = "hits" if sub == "forward-taint" else "chain"
                for r in out[key]:
                    extra = r.get("why") or r.get("via", "")
                    print(f"#{r['idx']:6d}  {r.get('func',''):<24s}+{r.get('off','')}  {r['asm']}  ; {extra}")
            elif sub == "strings":
                for r in out["strings"]: print(f"{r['addr']}  ({r['len']:3d})  {r['str']!r}")
            elif sub == "cfg":
                print(f"blocks={out['block_count']} edges={out['edge_count']} entry={out['entry']}")
                for b in sorted(out["blocks"], key=lambda x: -x["executions"])[:30]:
                    print(f"  {b['off']:>10s} ×{b['executions']:5d}  insns={b['insns']:3d}")
            elif sub == "search":
                for r in out["hits"]: print(f"#{r['idx']:6d}  {r['off']}  {r['asm']}")
            elif sub == "func-summary":
                for r in out["functions"][:30]:
                    print(f"  {r['func']:<28s}  ×{r['count']:6d}  first=#{r['first_idx']} last=#{r['last_idx']}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="tracemiku", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="subcommand", required=True)

    # trace
    p_tr = sp.add_parser("trace", help="采集 trace")
    p_tr.add_argument("--pkg", required=False, help="目标 app 包名")
    p_tr.add_argument("--attach-pid", type=int, help="直接附加 pid")
    p_tr.add_argument("--so", required=True, help="目标 SO 名子串")
    p_tr.add_argument("--method", help="JNI 注册方法名 (动态注册)")
    p_tr.add_argument("--export", help="SO 导出函数名 (静态导出)")
    p_tr.add_argument("--fn-offset", help="SO 内函数偏移 (16进制如 0x57770)")
    p_tr.add_argument("--cmd", type=int, help="cmd id 过滤值 (默认 0=不过滤)")
    p_tr.add_argument("--cmd-arg", type=int, default=2, help="cmd id 在第几个参数 (默认 2)")
    p_tr.add_argument("--max-records", type=int, default=5000000)
    p_tr.add_argument("--follow-workers", action="store_true",
                      help="跟踪 pthread_create 新生成的 worker 线程 (异步函数才需要; 默认关，不然 TB 类 app 易闪退)")
    p_tr.add_argument("--no-workers", action="store_true", help="(deprecated, 默认就是不跟)")
    p_tr.add_argument("--duration", type=int, default=120)
    p_tr.add_argument("--out", required=True, help="输出目录")
    p_tr.add_argument("--remote", default="127.0.0.1:6699", help="frida server 地址")
    p_tr.add_argument("--mode", choices=["js", "cmodule"], default="cmodule",
                      help="trace 实现: js=JS callout (~30K rec/s) cmodule=CModule native (10x+, 默认)")
    p_tr.add_argument("--cold-launch", action="store_true",
                      help="冷启动 app 前自动 force-stop+pm clear+monkey+点'同意' (适用 TB 类首启隐私协议)")

    # view
    p_vw = sp.add_parser("view", help="启动 TUI 查看器")
    p_vw.add_argument("path", help="trace 目录或 .bin 文件")

    # query (AI 友好)
    p_qy = sp.add_parser("query", help="JSON 查询接口")
    p_qy.add_argument("path", help="trace 目录或 .bin 文件")
    qsp = p_qy.add_subparsers(dest="sub", required=True)
    # add --json to every subparser uniformly
    def _addj(sub):
        sub.add_argument("--json", action="store_true", help="输出 JSON"); return sub
    q_r = _addj(qsp.add_parser("records", help="按范围导出指令记录"))
    q_r.add_argument("--range", help="范围 a..b (默认全部)"); q_r.add_argument("--regs", help="逗号分隔的寄存器名")
    q_ft = _addj(qsp.add_parser("forward-taint", help="正向污点"))
    q_ft.add_argument("--from", dest="from_", type=int, required=True); q_ft.add_argument("--reg", required=True); q_ft.add_argument("--max", type=int, default=500)
    q_bt = _addj(qsp.add_parser("backward-taint", help="反向污点"))
    q_bt.add_argument("--from", dest="from_", type=int, required=True); q_bt.add_argument("--reg", required=True); q_bt.add_argument("--max", type=int, default=500)
    q_st = _addj(qsp.add_parser("strings", help="字符串提取")); q_st.add_argument("--min-len", type=int, default=4)
    q_cfg = _addj(qsp.add_parser("cfg", help="CFG 数据"))
