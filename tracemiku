#!/usr/bin/env python3
import os, sys

"""tracemiku — 安卓真机 ARM64 指令级 trace 全栈工具.

子命令:
  trace    采集 trace (任意 app 任意 SO 任意函数)
  probe    轻量级导出函数 Interceptor 计数 (不启动 Stalker, 无 trace)
  view     启动 Rust v2 Web 查看器
  api      调用任意 Rust v2 JSON API route (仅当无专用子命令时使用)
  query    JSON 查询接口 (优先使用此命令及其他专用子命令)
  list     列出已有 trace
  info     trace 元信息

示例:
  tracemiku trace --pkg com.example.app --so libtarget.so \\
    --method nativeEntry --duration 90 --out traces/run1
  tracemiku view traces/run1
  tracemiku query traces/run1 records --range 0..50 --regs x0,x1,x2 --json
  tracemiku query traces/run1/calls/call_001_tid1_100r_1ms backtrace --idx 100
  tracemiku query traces/run1 forward-taint --from 0 --reg x2 --json
  tracemiku query traces/run1 strings --json
"""
import sys, os, pathlib, argparse, json, subprocess, time
from tracemiku_fork import (_spawn_child_poller, _parse_proc_stat,
                           _poll_child_lifecycle, _print_fork_summary)
from tracemiku_device import (_check_device,
                              cold_launch_start as _cold_launch_start,
                              launch_start as _launch_start,
                              drive_consent as _drive_consent,
                              CONSENT_BUTTON_PATTERNS)

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

def _rust_cli_cmd(args):
    bin_path = os.environ.get("TRACEMIKU_CLI_BIN")
    if bin_path:
        return [bin_path, *args]
    debug_bin = HERE / "rust" / "target" / "debug" / "tracemiku-cli"
    if debug_bin.exists():
        return [str(debug_bin), *args]
    return [
        "cargo", "run", "--quiet", "--manifest-path", str(HERE / "rust" / "Cargo.toml"),
        "-p", "tracemiku-cli", "--", *args,
    ]


def _run_rust_cli(args):
    return subprocess.call(_rust_cli_cmd(args))


def _rust_cli_json(args):
    r = subprocess.run(_rust_cli_cmd(args), capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"tracemiku-cli exited {r.returncode}")
    return json.loads(r.stdout)


def _is_ret_inst(inst):
    # Host-side ret detection for trace-begin/finalize meta (meta.json not yet
    # written, so the CLI `info` route cannot serve it). Mirrors the core
    # disasm ret classification; behavior is locked by
    # tests/host_trace_helpers_test.py (2000-encoding cross-check vs core blr
    # mask, zero conflicts). Keep in sync when core changes the mask.
    return (inst & 0xfffffc1f) == 0xd65f0000


def _decode_last_inst(pc, inst):
    # Same rationale as _is_ret_inst: used before meta.json exists. Prefers
    # capstone for full mnemonic/operands, falls back to the mask check.
    try:
        import capstone
        cs = capstone.Cs(capstone.CS_ARCH_ARM64, capstone.CS_MODE_ARM)
        insns = list(cs.disasm(inst.to_bytes(4, "little"), pc, count=1))
        if insns:
            insn = insns[0]
            asm = f"{insn.mnemonic} {insn.op_str}".strip()
            return insn.mnemonic == "ret", asm
    except Exception:
        pass
    return _is_ret_inst(inst), f".inst 0x{inst:08x}"


REC_SIZE = 272  # trace.bin record size (stable contract)

def _read_trace_tail(bin_path):
    # Reads first/last record bytes directly from trace.bin before meta.json
    # exists (trace-begin/finalize path). This is a deliberate host-side I/O
    # helper, NOT a re-implementation of core parsing: it only extracts the
    # two boundary records and defers instruction decoding to _decode_last_inst.
    # Contract-locked by tests/host_trace_helpers_test.py.
    size = bin_path.stat().st_size if bin_path.exists() else 0
    n = size // REC_SIZE
    first_pc = last_pc = last_inst = None
    if n > 0:
        with open(bin_path, "rb") as bf:
            head = bf.read(272)
            first_pc = int.from_bytes(head[:8], "little")
            if n > 1:
                bf.seek((n - 1) * 272)
                tail = bf.read(272)
            else:
                tail = head
            last_pc = int.from_bytes(tail[:8], "little")
            last_inst = int.from_bytes(tail[268:272], "little")
    return n, first_pc, last_pc, last_inst






def cmd_trace(args):
    """spawn frida agent, save trace."""
    try:
        import frida
    except ImportError:
        print("error: trace 子命令需要 frida; install with: pip install frida", file=sys.stderr)
        return 1
    import signal, threading
    cold_pid = None
    consent_thread = None
    launch_pid = None
    spawn_pid = None
    spawn_gating_active = False
    if getattr(args, "launch", False) and getattr(args, "cold_launch", False):
        print("[!] --launch and --cold-launch are mutually exclusive", file=sys.stderr)
        return 2
    if getattr(args, "spawn", False):
        if getattr(args, "launch", False) or getattr(args, "cold_launch", False) or args.attach_pid:
            print("[!] --spawn 与 --launch/--cold-launch/--attach-pid 互斥", file=sys.stderr)
            return 2
        if not args.pkg:
            print("[!] --spawn 需要 --pkg <包名>", file=sys.stderr)
            return 2
    if args.cmd is not None and args.cmd_arg is None:
        print("[!] --cmd 需要配合 --cmd-arg 指定参数下标 (0-based), "
              "不再假设任何目标默认值", file=sys.stderr)
        return 2
    if getattr(args, "launch", False) and args.pkg:
        try:
            launch_pid = _launch_start(args.pkg)
        except Exception as e:
            print(f"[!] launch 失败: {e}")
            return 2
    if getattr(args, "cold_launch", False) and args.pkg:
        try:
            cold_pid = _cold_launch_start(args.pkg)
            # 在后台线程跑同意/UI settle, 不阻塞 attach
            # (Qunar 类: 必须在隐私弹窗前 attach 否则 anti-debug 卡死 frida)
            home_markers = getattr(args, "home_markers", None)
            def _bg_consent():
                try: _drive_consent(args.pkg, home_markers=home_markers)
                except Exception as e: print(f"[!] consent driver 失败 (非致命): {e}", flush=True)
            consent_thread = threading.Thread(target=_bg_consent, daemon=True)
            consent_thread.start()
        except Exception as e: print(f"[!] cold-launch 失败: {e}"); return 2
    # 选择 agent 文件 (按 --mode)
    agent_map = {
        "cmodule": "_agent.js",              # 默认: 模块化 TS agent (frida-compile), CModule + SPSC + 设备落盘, ~1.5M rec/s
        "legacy":  "agent_cmodule_v5.js",    # 旧版单文件 agent (兼容回退)
    }
    agent_name = agent_map.get(args.mode, "_agent.js")
    AGENT_PATH = HERE / "tracer" / agent_name
    AGENT = AGENT_PATH.read_text()
    print(f"[host] using agent: {agent_name} (mode={args.mode})", flush=True)

    OUT = pathlib.Path(args.out); OUT.mkdir(parents=True, exist_ok=True)
    CALLS_DIR = OUT / "calls"; CALLS_DIR.mkdir(exist_ok=True)
    log_fp = open(OUT/"log.txt", "w")
    sess_files = {}    # callIdx -> {fp, meta, dir, callIdx, tid}
    top_meta = {
        "pkg": args.pkg, "so": args.so,
        "method": args.method, "export": args.export,
        "fn_offset": args.fn_offset, "cmd": args.cmd,
        "spawned": bool(getattr(args, "spawn", False)),
        "started_at": time.time(), "calls": [],
        "tracemiku_cli": True, "per_call": True,
    }

    def wlog(s):
        line = f"[{time.strftime('%H:%M:%S')}] {s}"
        print(line, flush=True); log_fp.write(line + "\n"); log_fp.flush()

    def open_call(call_idx, tid, pid):
        if call_idx in sess_files: return sess_files[call_idx]
        d = CALLS_DIR / f"_pending_call_{call_idx:03d}"
        d.mkdir(exist_ok=True)
        # v5: agent 端落盘到 device, host 不再持久接 stream → fp=None.
        # 兼容 v3/v4: 若 agent 仍 send blob, on_message 在收到第一个 frames 时 lazy-open 写盘.
        md = {"callIdx": call_idx, "pid": pid, "tid": tid,
              "ts_in": time.time(), "started_at": time.time(),
              "format_version": 1, "record_size": REC_SIZE,
              "records": 0, "bytes": 0,
              "truncated": True, "last_insn_is_ret": None,
              "devicePath": None}
        sess_files[call_idx] = {"fp": None, "meta": md, "dir": d,
                                "callIdx": call_idx, "tid": tid, "pid": pid}
        return sess_files[call_idx]

    # Probed once per process: does this device need root to read app caches?
    # On user builds, /data/data/<pkg>/cache/ is owned by app uid — shell uid can't read.
    # On userdebug / KSU-rooted devices, we wrap with `su -c` to bypass.
    _adb_pull_use_su = [None]

    def _detect_su_needed():
        if _adb_pull_use_su[0] is not None:
            return _adb_pull_use_su[0]
        # quick probe: try reading a known root-only path as shell; if denied, use su
        r = subprocess.run(["adb", "shell", "id"], capture_output=True, text=True, timeout=5)
        is_root_shell = "uid=0" in (r.stdout or "")
        _adb_pull_use_su[0] = not is_root_shell
        return _adb_pull_use_su[0]

    def _wrap_su(cmd):
        """Wrap a shell command with `su -c` if needed (for KSU/Magisk-rooted user builds)."""
        import shlex as _sx
        if _detect_su_needed():
            # double-quote-safe escaping via single-quotes inside su -c '...'
            return f"su -c {_sx.quote(cmd)}"
        return cmd

    def adb_pull_device_trace(device_path, dst_path):
        """从设备拉 trace 文件到 host.
           优先 gzip-stream (~25x 压缩, ~10x 加速); 部分 ROM (e.g. ColorOS)
           的 toybox gzip 不输出合法 gzip magic — 检测失败时 fallback 到 raw cat.
           App cache 路径只有 app uid / root 能读 — 自动检测并用 su -c 包装.
           失败抛异常.
        """
        import gzip as _gz, shlex
        # ---- try gzip-stream first ----
        gz_err = None
        try:
            with open(dst_path, "wb") as dst:
                inner = f"gzip -1 -c {shlex.quote(device_path)}"
                cmd = _wrap_su(inner)
                ps = subprocess.Popen(["adb", "exec-out", cmd],
                                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                try:
                    gz = _gz.GzipFile(fileobj=ps.stdout, mode="rb")
                    while True:
                        chunk = gz.read(4 * 1024 * 1024)
                        if not chunk: break
                        dst.write(chunk)
                    gz.close()
                finally:
                    ps.stdout.close()
                    ps.wait(timeout=30)
                if ps.returncode != 0:
                    stderr = ps.stderr.read().decode("utf-8","replace")[:200]
                    raise RuntimeError(f"adb exec-out gzip rc={ps.returncode} {stderr}")
            size = pathlib.Path(dst_path).stat().st_size
            if size == 0:
                raise RuntimeError("gzip pull 拉到 0 字节")
        except Exception as e:
            gz_err = e
        # ---- fallback: raw cat (slower, but works on ColorOS-style toybox gzip) ----
        if gz_err is not None:
            wlog(f"  gzip pull 失败 ({gz_err}); 回退 raw cat")
            with open(dst_path, "wb") as dst:
                inner = f"cat {shlex.quote(device_path)}"
                cmd = _wrap_su(inner)
                ps = subprocess.Popen(["adb", "exec-out", cmd],
                                      stdout=dst, stderr=subprocess.PIPE)
                ps.wait(timeout=180)
                if ps.returncode != 0:
                    stderr = ps.stderr.read().decode("utf-8","replace")[:200]
                    raise RuntimeError(f"raw cat 也失败: rc={ps.returncode} {stderr} (gzip 错误: {gz_err})")
            size = pathlib.Path(dst_path).stat().st_size
            if size == 0:
                raise RuntimeError(f"raw cat 拉到 0 字节 (gzip 错误: {gz_err})")
        # cleanup device file (also via su if needed)
        rm_cmd = _wrap_su(f"rm -f {shlex.quote(device_path)}")
        subprocess.run(["adb", "shell", rm_cmd], capture_output=True)
        return size

    def finalize_call(s, *, truncated):
        """Close .bin, decode last insn, write meta.json, rename dir."""
        try:
            if s.get("fp"): s["fp"].close()
        except: pass
        try:
            if s.get("ext_fp"): s["ext_fp"].close()
        except: pass
        try:
            if s.get("jni_fp"): s["jni_fp"].close()
        except: pass
        try:
            if s.get("semantic_fp"): s["semantic_fp"].close()
        except: pass
        # v5: 从 device 拉 trace.bin
        device_path = s["meta"].get("devicePath")
        if device_path:
            try:
                local_path = s["dir"] / "trace.bin"
                t0 = time.time()
                size = adb_pull_device_trace(device_path, str(local_path))
                wlog(f"  pull {device_path} → {size:,} bytes in {time.time()-t0:.1f}s")
                s["meta"]["bytes"] = size
            except Exception as e:
                wlog(f"[!] pull device trace 失败: {e}")
        # Optional SIMD sidecar: separate file so the main 272B trace.bin format
        # remains stable and lightweight.
        simd_device_path = s["meta"].get("simdDevicePath")
        if simd_device_path:
            try:
                simd_local_path = s["dir"] / "simd_trace.bin"
                t0 = time.time()
                simd_size = adb_pull_device_trace(simd_device_path, str(simd_local_path))
                wlog(f"  pull SIMD {simd_device_path} → {simd_size:,} bytes in {time.time()-t0:.1f}s")
                rec_size = int(s["meta"].get("simdRecordSize") or 520)
                recs = s["meta"].get("simdRecords")
                if recs is None and rec_size > 0:
                    recs = simd_size // rec_size
                s["meta"]["simd_sidecar"] = {
                    "file": "simd_trace.bin",
                    "bytes": simd_size,
                    "record_size": rec_size,
                    "records": int(recs or 0),
                    "dropped": int(s["meta"].get("simdDropped") or 0),
                    "sample_stride": int(s["meta"].get("simdSampleStride") or 1),
                }
            except Exception as e:
                wlog(f"[!] pull SIMD sidecar 失败: {e}")
        # Optional initial memory snapshot: real device memory at t=0, used by
        # MemShadow as the `i` fallback layer for pre-trace data (decrypted
        # bytecode tables, .rodata constants). See docs/memory-completeness-design.md.
        snap_device_path = s["meta"].get("snapshotDevicePath")
        if snap_device_path:
            try:
                snap_local_path = s["dir"] / "memory_snapshot.bin"
                t0 = time.time()
                snap_size = adb_pull_device_trace(snap_device_path, str(snap_local_path))
                wlog(f"  pull snapshot {snap_device_path} → {snap_size:,} bytes in {time.time()-t0:.1f}s")
                s["meta"]["memory_snapshot"] = {
                    "file": "memory_snapshot.bin",
                    "bytes": snap_size,
                    "regions": int(s["meta"].get("snapshotRegions") or 0),
                }
            except Exception as e:
                wlog(f"[!] pull memory snapshot 失败: {e}")
        worker_sidecars = []
        for wt in s["meta"].get("workerTraces") or []:
            worker_device_path = wt.get("devicePath")
            if not worker_device_path:
                continue
            tid = wt.get("tid", "unknown")
            try:
                worker_local_name = f"worker_trace_tid{tid}.bin"
                worker_local_path = s["dir"] / worker_local_name
                t0 = time.time()
                worker_size = adb_pull_device_trace(worker_device_path, str(worker_local_path))
                wlog(f"  pull worker tid={tid} {worker_device_path} → {worker_size:,} bytes in {time.time()-t0:.1f}s")
                rec_size = int(wt.get("recordSize") or REC_SIZE)
                records = int(wt.get("records") or (worker_size // rec_size if rec_size > 0 else 0))
                worker_sidecars.append({
                    "tid": wt.get("tid"),
                    "pthread": wt.get("pthread"),
                    "start": wt.get("start"),
                    "file": worker_local_name,
                    "bytes": worker_size,
                    "record_size": rec_size,
                    "records": records,
                    "dropped": int(wt.get("dropped") or 0),
                })
            except Exception as e:
                wlog(f"[!] pull worker sidecar tid={tid} 失败: {e}")
        if worker_sidecars:
            s["meta"]["worker_trace_sidecars"] = worker_sidecars
        md = s["meta"]
        md["truncated"] = bool(truncated)
        md["format_version"] = int(md.get("format_version") or 1)
        md["record_size"] = int(md.get("record_size") or REC_SIZE)
        md["closed_at"] = time.time()
        # decode first/last insn
        bin_path = s["dir"]/"trace.bin"
        first_pc = last_pc = None
        last_is_ret = None
        n, first_pc, last_pc, last_inst = _read_trace_tail(bin_path)
        if last_inst is not None:
            try:
                last_is_ret, _ = _decode_last_inst(last_pc, last_inst)
            except Exception as e:
                wlog(f"[!] decode last insn 失败: {e}")
        md["records"] = n
        md["first_pc"] = hex(first_pc) if first_pc is not None else None
        md["last_pc"]  = hex(last_pc)  if last_pc  is not None else None
        md["last_insn_is_ret"] = last_is_ret
        # 真完整 = onLeave 触发 + 最后一条是 ret
        # rename dir to call_NNN_tidT_Rrec_Mms or _truncated_call_NNN_R
        ms_v = md.get("ms")
        ms_str = "?ms" if ms_v is None else f"{int(ms_v)}ms"
        if truncated:
            new_name = f"_truncated_call_{md['callIdx']:03d}_tid{md['tid']}_{n}r_{ms_str}"
        else:
            new_name = f"call_{md['callIdx']:03d}_tid{md['tid']}_{n}r_{ms_str}"
        new_dir = CALLS_DIR / new_name
        if new_dir.exists():
            new_dir = CALLS_DIR / (new_name + "_dup")
        try:
            s["dir"].rename(new_dir)
            s["dir"] = new_dir
        except Exception as e:
            wlog(f"[!] rename {s['dir']}->{new_name} 失败: {e}")
        # 写 meta.json (rename 后)
        json.dump(md, open(s["dir"]/"meta.json","w"), indent=2)
        return md

    def make_cb(pid, tag):
        def cb(m, data):
            if m["type"] == "send":
                p = m["payload"]
                if isinstance(p, dict):
                    t = p.get("type")
                    if t == "log": wlog(f"[{tag}] {p['msg']}")
                    elif t == "frames":
                        ci = p.get("callIdx")
                        tid = p.get("tid", 0)
                        if ci is None:
                            wlog(f"[{tag}] frames 缺 callIdx, 丢弃 {p.get('recs')} 条"); return
                        s = sess_files.get(ci) or open_call(ci, tid, pid)
                        # 兼容 v3/v4 的 send-blob 模式 (v5 不送 blob, 直接落盘 device)
                        if data:
                            if s.get("fp") is None:
                                s["fp"] = open(s["dir"]/"trace.bin", "wb")
                            s["fp"].write(data)
                            s["meta"]["bytes"] += len(data)
                        s["meta"]["records"] += p["recs"]
                        wlog(f"[{tag}] call#{ci} tid={tid} +{p['recs']} (total={p['total']}, {p.get('reason','?')})")
                    elif t == "module":
                        if "module" not in top_meta:
                            top_meta["module"] = {k: p[k] for k in ("name","base","size")}
                        wlog(f"[{tag}] 模块 {p['name']} @ {p['base']}")
                    elif t == "modules":
                        if "modules" not in top_meta:
                            top_meta["modules"] = p["modules"]
                        wlog(f"[{tag}] {len(p['modules'])} 个已加载模块")
                    elif t == "fn-resolved":
                        top_meta["fn_addr"] = p["addr"]
                        wlog(f"[{tag}] 函数 @ {p['addr']}")
                    elif t == "register-native":
                        top_meta["registration"] = {k: p[k] for k in ("name","sig","fp")}
                        wlog(f"[{tag}] 动态注册 {p['name']} {p['sig']} → {p['fp']}")
                    elif t == "trace-begin":
                        ci = p.get("callIdx") or 0
                        open_call(ci, p["tid"], pid)
                        # ts_in 用 host 时钟; agent 的 Date.now() 是设备时钟, 与 host 可能差几小时/天
                        sess_files[ci]["meta"]["ts_in"] = time.time()
                        sess_files[ci]["meta"]["ts_device_in_ms"] = p.get("ts")
                        # v5: agent 落盘 device, host 之后 adb pull
                        if p.get("devicePath"):
                            sess_files[ci]["meta"]["devicePath"] = p["devicePath"]
                        for k in ("simdDevicePath", "simdRecordSize", "simdSampleStride"):
                            if p.get(k) is not None:
                                sess_files[ci]["meta"][k] = p.get(k)
                        wlog(f"[{tag}] trace 开始 call#{ci} tid={p['tid']}{' device='+p['devicePath'] if p.get('devicePath') else ''}")
                    elif t == "trace-end":
                        ci = p.get("callIdx") or 0
                        if ci not in sess_files:
                            open_call(ci, p.get("tid", 0), pid)
                        s = sess_files[ci]
                        s["meta"]["retval"] = p.get("retval")
                        s["meta"]["ms"] = p.get("ms")
                        s["meta"]["dropped"] = p.get("dropped", 0)
                        s["meta"]["ts_out"] = time.time()
                        if p.get("devicePath"):     # v5
                            s["meta"]["devicePath"] = p["devicePath"]
                        for k in ("simdDevicePath", "simdRecords", "simdDropped",
                                  "simdRecordSize", "simdSampleStride", "workerTraces"):
                            if p.get(k) is not None:
                                s["meta"][k] = p.get(k)
                        truncated = bool(p.get("truncated", False))
                        finalize_call(s, truncated=truncated)
                        del sess_files[ci]
                        wlog(f"[{tag}] trace 结束 call#{ci} tid={p.get('tid')} ms={p.get('ms')} ret={p.get('retval')} truncated={truncated} dropped={p.get('dropped',0)}")
                    elif t == "semantic-events":
                        # Optional semantic IPC stream. Full events are stored as
                        # JSONL; meta keeps only a bounded preview plus a count.
                        ci = p.get("callIdx") or 0
                        if ci not in sess_files:
                            open_call(ci, p.get("tid", 0), pid)
                        evs = p.get("events", [])
                        s = sess_files[ci]
                        sf = s.get("semantic_fp")
                        if sf is None:
                            sf = open(s["dir"] / "semantic_events.jsonl", "a", encoding="utf-8")
                            s["semantic_fp"] = sf
                        for ev in evs:
                            sf.write(json.dumps(ev, ensure_ascii=False) + "\n")
                        sf.flush()
                        md = s["meta"]
                        md["semantic_events_count"] = int(md.get("semantic_events_count") or 0) + len(evs)
                        sample = md.setdefault("semantic_events_sample", [])
                        remain = max(0, 200 - len(sample))
                        if remain:
                            sample.extend(evs[:remain])
                        wlog(f"[{tag}] semantic-events call#{ci} +{len(evs)} (total={md['semantic_events_count']})")
                    elif t == "jni-hooks" or t == "jni-strings":
                        # JSON-driven JNI hooks (libart, Interceptor — not Stalker, anti-detect 看不到).
                        # 每条 event = {id, trace_idx, args:{name:val,...}, ret}.
                        # 写到 per-call 目录 jni_hooks.jsonl (line-delimited JSON, 跨 trace 复用).
                        # 同时也进 meta.json 的 jni_hooks 数组 (前端方便查).
                        ci = p.get("callIdx") or 0
                        if ci not in sess_files:
                            open_call(ci, p.get("tid", 0), pid)
                        evs = p.get("events", [])
                        s = sess_files[ci]
                        jh_path = s["dir"] / "jni_hooks.jsonl"
                        jf = s.get("jni_fp")
                        if jf is None:
                            jf = open(jh_path, "a"); s["jni_fp"] = jf
                        for ev in evs:
                            jf.write(json.dumps(ev, ensure_ascii=False) + "\n")
                        jf.flush()
                        m_jni = s["meta"].setdefault("jni_hooks", [])
                        m_jni.extend(evs)
                        wlog(f"[{tag}] {t} call#{ci} +{len(evs)} (total={len(m_jni)})")
                    elif t == "fork-events":
                        # P1-C M1: agent 端 fork/clone hook 抓到的 fork-event Tier 1.
                        # 写入 per-call meta.json `fork_events` 数组, Rust API 通过
                        # /api/fork-events + CLI wrapper 暴露.
                        ci = p.get("callIdx") or 0
                        if ci not in sess_files:
                            open_call(ci, p.get("tid", 0), pid)
                        evs = p.get("events", [])
                        s = sess_files[ci]
                        m_fork = s["meta"].setdefault("fork_events", [])
                        m_fork.extend(evs)
                        # 实时 CLI 提示 (P1-C 实时输出格式)
                        for ev in evs:
                            sym_label = ev.get("parent_pc_rel") or ev.get("parent_pc", "?")
                            kind = "fork-like" if ev.get("is_fork_like") else "thread-like"
                            wlog(f"[{tag}] [FORK] call#{ci} parent={sym_label} "
                                 f"({ev.get('syscall')}, {kind}) → child pid={ev.get('child_pid')}")
                            cpid = ev.get("child_pid")
                            # P1-C M2: race-attach to fork-like children
                            if (ev.get("is_fork_like") and cpid and cpid > 0
                                    and child_trace_mode in ("full", "safe")):
                                _race_attach_child(ev)
                            # P1-C M3: kick off background lifecycle poll
                            if (ev.get("is_fork_like") and cpid and cpid > 0
                                    and getattr(args, "fork_poll_child", True)):
                                _spawn_child_poller(ev, s["meta"], wlog, tag)
                    elif t == "worker-events":
                        ci = p.get("callIdx") or 0
                        if ci not in sess_files:
                            open_call(ci, p.get("tid", 0), pid)
                        evs = p.get("events", [])
                        s = sess_files[ci]
                        m_workers = s["meta"].setdefault("worker_events", [])
                        m_workers.extend(evs)
                        s["meta"]["worker_events_count"] = len(m_workers)
                        for ev in evs[:8]:
                            wlog(f"[{tag}] worker-event status={ev.get('status', '?')} "
                                 f"tid={ev.get('tid', '?')}")
                    elif t == "ext-write":
                        # Boundary-diff events from --trace-deep mode.
                        # Each event: {attrIdx: u64, addr: "0x...", byte: u8}.
                        # Append to external_writes.bin in per-call dir.
                        # Format per record: <Q (attr_idx) <Q (addr) <B (byte) = 17 bytes.
                        ci = p.get("callIdx") or 0
                        if ci not in sess_files:
                            open_call(ci, p.get("tid", 0), pid)
                        evs = p.get("events", [])
                        s = sess_files[ci]
                        ext_path = s["dir"] / "external_writes.bin"
                        # Append-mode binary stream (open lazy, kept on session)
                        ef = s.get("ext_fp")
                        if ef is None:
                            ef = open(ext_path, "ab"); s["ext_fp"] = ef
                        import struct as _st
                        for ev in evs:
                            try:
                                addr = int(ev["addr"], 16) if isinstance(ev["addr"], str) else int(ev["addr"])
                                ef.write(_st.pack("<QQB", int(ev["attrIdx"]), addr, int(ev["byte"]) & 0xff))
                            except Exception as _e:
                                pass
                        ef.flush()
                        s["meta"]["ext_writes"] = s["meta"].get("ext_writes", 0) + len(evs)
                        wlog(f"[{tag}] ext-write call#{ci} +{len(evs)} (total={s['meta']['ext_writes']})")
                    elif t == "mem-snapshot":
                        # Initial memory snapshot captured at trace start. Record
                        # device path on the session so finalize() pulls it.
                        ci = p.get("callIdx") or 0
                        if ci not in sess_files:
                            open_call(ci, p.get("tid", 0), pid)
                        s = sess_files[ci]
                        s["meta"]["snapshotDevicePath"] = p.get("devicePath")
                        s["meta"]["snapshotRegions"] = p.get("regions", 0)
                        wlog(f"[{tag}] mem-snapshot call#{ci}: {p.get('regions',0)} regions, "
                             f"{int(p.get('bytes',0))/1024/1024:.1f}MB → {p.get('devicePath')}")
                    elif t == "follow": wlog(f"[{tag}] 跟踪 tid={p['tid']} ({p.get('label','?')})")
                    elif t == "hb":
                        wlog(f"[{tag}] HB head={p['head']} total={p['total']} dropped={p['dropped']} fnEntered={p['fnEntered']}")
                    elif t == "hello":
                        wlog(f"[{tag}] agent 启动 frida={p['frida']}")
                    else:
                        wlog(f"[{tag}] {json.dumps(p, ensure_ascii=False)}")
                else: wlog(f"[{tag}] {p}")
            elif m["type"] == "error":
                wlog(f"[{tag}] 错误 {m.get('description')}")
                if "stack" in m: wlog(m["stack"])
        return cb

    # Pre-flight device check (non-blocking, best-effort)
    if not args.remote:
        _, fails, _ = _check_device(
            pkg=args.pkg, out_dir=None, verbose=False)
        if fails > 0:
            wlog("[preflight] 检测到设备问题, 运行 `./tracemiku doctor` 查看详情")

    mgr = frida.get_device_manager()
    if args.remote:
        device = mgr.add_remote_device(args.remote)
    else:
        device = frida.get_usb_device(timeout=10)
    wlog(f"device={device}")

    # --spawn: 与 frida 直接 spawn 行为一致。enable_spawn_gating →
    # device.spawn(pkg)（进程挂起）→ attach + agent init → resume。
    # 不 force-stop、不 pm clear、不点同意；需要干净状态由调用方先处理。
    if getattr(args, "spawn", False):
        try:
            device.enable_spawn_gating()
            spawn_gating_active = True
            spawn_pid = device.spawn([args.pkg])
            wlog(f"[spawn] gating enabled, pid={spawn_pid} (挂起中, init 完成后 resume)")
        except Exception as e:
            wlog(f"[!] spawn 失败: {type(e).__name__}: {e}")
            if spawn_gating_active:
                try: device.disable_spawn_gating()
                except Exception: pass
            log_fp.close(); return 2

    incl_pats = []
    if args.include_so:
        incl_pats = [p.strip() for p in args.include_so.split(",") if p.strip()]
    stalker_exc_pats = []
    if getattr(args, "stalker_exclude_patterns", None):
        stalker_exc_pats = [p.strip() for p in args.stalker_exclude_patterns.split(",") if p.strip()]
    diff_pats = []
    if getattr(args, "boundary_diff_patterns", None):
        diff_pats = [p.strip() for p in args.boundary_diff_patterns.split(",") if p.strip()]
    # Load JNI hooks JSON (default = bundled libart_jni.json)
    jni_hooks_specs = []
    jh_arg = getattr(args, "jni_hooks", None)
    if jh_arg and jh_arg.lower() != "none":
        # If relative path, resolve against project root (= dir containing tracemiku script)
        jh_path = pathlib.Path(jh_arg)
        if not jh_path.is_absolute():
            jh_path = pathlib.Path(__file__).resolve().parent / jh_arg
        if jh_path.exists():
            try:
                jh_doc = json.loads(jh_path.read_text())
                jni_hooks_specs = jh_doc.get("hooks", [])
                wlog(f"loaded {len(jni_hooks_specs)} JNI hook specs from {jh_path}")
            except Exception as e:
                wlog(f"[!] failed to load --jni-hooks {jh_path}: {e}")
        else:
            wlog(f"[!] --jni-hooks file not found: {jh_path} (skipping)")
    # Load suicide-patch spec JSON (per-SO-version offset list).
    suicide_spec = None
    sps_arg = getattr(args, "suicide_patch_spec", None)
    if bool(getattr(args, "patch_suicide", False)) and not sps_arg:
        wlog("[!] --patch-suicide requires --suicide-patch-spec PATH")
        raise SystemExit(2)
    if bool(getattr(args, "patch_suicide", False)) and sps_arg:
        sps_path = pathlib.Path(sps_arg)
        if not sps_path.is_absolute():
            sps_path = pathlib.Path(__file__).resolve().parent / sps_arg
        if sps_path.exists():
            try:
                suicide_spec = json.loads(sps_path.read_text())
                wlog(f"loaded suicide-patch spec ({len(suicide_spec.get('patches', []))} offsets) from {sps_path}")
            except Exception as e:
                wlog(f"[!] failed to load --suicide-patch-spec {sps_path}: {e}")
        else:
            wlog(f"[!] --suicide-patch-spec file not found: {sps_path}")
    # --trace-all safety rails. Capturing every instruction incl. the full ART
    # interpreter is the highest-volume mode. Anti-detect stays OPT-IN: the user
    # enables --hide-rwx-maps / --block-self-kill / --patch-suicide explicitly
    # when the target is hardened. We do NOT force them on (default off).
    trace_all = bool(getattr(args, "trace_all", False))
    if trace_all:
        # Volume guard: full capture can emit billions of records and reboot the
        # device. Refuse 0 (unbounded); cap to a sane ceiling if oversized.
        TRACE_ALL_MAX = 50_000_000
        if not args.max_records or args.max_records <= 0:
            wlog(f"[trace-all] max_records unbounded → forcing cap {TRACE_ALL_MAX} "
                 f"(full capture is extreme volume; --max-records to override)")
            args.max_records = TRACE_ALL_MAX
        elif args.max_records > TRACE_ALL_MAX:
            wlog(f"[trace-all] WARN: max_records={args.max_records} is very high; "
                 f"device may freeze/reboot. Proceeding as requested.")
        wlog("[trace-all] capturing EVERY instruction (target + libc/libm + all "
             "userland/vendor SOs; ART apex family + linker excluded). "
             "anti-detect is OFF unless --hide-rwx-maps/--block-self-kill/--patch-suicide given.")

    AGENT_OPTS = {
        "soPattern": args.so,
        "methodName": args.method,
        "exportName": args.export,
        "fnOffset": int(args.fn_offset, 16) if args.fn_offset else None,
        **({"cmdArg": args.cmd_arg} if args.cmd is not None else {}),
        **({"cmdValue": args.cmd} if args.cmd is not None else {}),
        "maxRecords": args.max_records,
        "followWorkers": bool(getattr(args, "follow_workers", False)),
        "maxWorkerThreads": int(getattr(args, "max_worker_threads", 4) or 4),
        "pkg": args.pkg,                    # v5 用来构 /data/data/<pkg>/cache/.miku 路径
        "includeSoPatterns": incl_pats,     # multi-SO trace
        "deepTrace": bool(getattr(args, "trace_deep", False)),
        "traceAll": trace_all,
        "stalkerExcludePatterns": stalker_exc_pats,
        "boundaryDiffPatterns": diff_pats,
        "extWriteCap": int(getattr(args, "ext_write_cap", 0) or 0),
        "patchSuicide": bool(getattr(args, "patch_suicide", False)),
        "suicidePatchSpec": suicide_spec,
        "hideRwxMaps": bool(getattr(args, "hide_rwx_maps", False)),
        "blockSelfKill": bool(getattr(args, "block_self_kill", False)),
        "jniHooks": jni_hooks_specs,
        "enableForkHook": bool(getattr(args, "enable_fork_hook", False)),
        "semanticEvents": bool(getattr(args, "semantic_events", False)),
        "simdSidecar": bool(getattr(args, "simd_sidecar", False)),
        "simdSampleStride": max(1, int(getattr(args, "simd_sample_stride", 1) or 1)),
        "snapshotMem": bool(getattr(args, "snapshot_mem", False)),
        "snapshotMaxBytes": int(getattr(args, "snapshot_max_mb", 512) or 512) * 1024 * 1024,
    }
    wlog(f"agent opts: {AGENT_OPTS}")

    pid = None
    if args.attach_pid:
        pid = args.attach_pid
    elif launch_pid is not None:
        pid = launch_pid
    elif cold_pid is not None:
        pid = cold_pid     # cold-launch 已拿到 pid, 直接用 (尽快 attach 避免 anti-debug 起来)
    elif spawn_pid is not None:
        pid = spawn_pid    # spawn-gating: 进程挂起, attach 后 init, 再 resume
    elif args.pkg:
        for p in device.enumerate_processes():
            if p.name == args.pkg: pid = p.pid; break
        if pid is None:
            r = subprocess.run(["adb","shell","pidof",args.pkg], capture_output=True, text=True)
            if r.stdout.strip(): pid = int(r.stdout.strip().split()[0])
    if pid is None:
        wlog(f"[!] 找不到目标进程 (pkg={args.pkg})")
        try:
            procs = [(p.name, p.pid) for p in device.enumerate_processes()]
            matches = [(n, p) for n, p in procs if args.pkg and args.pkg.lower() in n.lower()]
            if matches:
                wlog(f"    可能的匹配进程:")
                for n, p in matches[:10]:
                    wlog(f"      {p:>6}  {n}")
            else:
                wlog(f"    设备当前进程 (前20):")
                for n, p in sorted(procs, key=lambda x: x[0])[:20]:
                    wlog(f"      {p:>6}  {n}")
        except Exception:
            pass
        wlog(f"    提示: 先启动 app 或用 --attach-pid <pid>")
        if spawn_gating_active:
            try: device.disable_spawn_gating()
            except Exception: pass
        log_fp.close(); return 1
    wlog(f"attach pid={pid}")
    # P1-C M2: child-attach — race-attach to fork()'d children by PID.
    # Note: enable_spawn_gating() doesn't catch arbitrary fork() of an
    # already-attached non-spawned process (Frida limitation, verified
    # 2026-05). So we use race-attach: agent fork-hook (M1) sends fork-event
    # IPC with child_pid → host immediately attaches BY PID.
    # Short-lived children (anti-debug 50-200ms) may exit before attach completes;
    # those get attach_status=failed_short_lived. Long-running children get traced.
    child_sessions = {}   # child_pid → {sess, scr}
    child_trace_mode = getattr(args, "child_trace_mode", "off")

    def _race_attach_child(fork_event):
        """P1-C M2: try to attach + inject agent into a freshly fork()'d child.
        Mutates fork_event['attach_status'] in-place."""
        cpid = fork_event.get("child_pid")
        if not cpid or cpid <= 0:
            fork_event["attach_status"] = "failed_unknown"
            return
        t0 = time.time()
        try:
            csess = device.attach(cpid)
        except Exception as e:
            msg = str(e).lower()
            if "process not found" in msg or "no such" in msg:
                fork_event["attach_status"] = "failed_short_lived"
            elif "trace" in msg or "ptrace" in msg:
                fork_event["attach_status"] = "failed_ptrace_conflict"
            else:
                fork_event["attach_status"] = "failed_unknown"
            wlog(f"[fork-attach][!] child {cpid}: {fork_event['attach_status']} ({e})")
            return
        try:
            cscr = csess.create_script(AGENT)
            cscr.on("message", make_cb(cpid, f"child{cpid}"))
            cscr.load()
            cscr.exports_sync.init(AGENT_OPTS)
            child_sessions[cpid] = {"sess": csess, "scr": cscr}
            elapsed = int((time.time() - t0) * 1000)
            fork_event["attach_status"] = "success"
            fork_event["attach_latency_ms"] = elapsed
            wlog(f"[fork-attach] child {cpid} attached + agent loaded ({elapsed}ms)")
        except Exception as e:
            try: csess.detach()
            except Exception: pass
            fork_event["attach_status"] = "failed_unknown"
            wlog(f"[fork-attach][!] child {cpid} script load failed: {e}")

    try:
        sess = device.attach(pid)
        scr = sess.create_script(AGENT)
        scr.on("message", make_cb(pid, args.pkg or f"pid{pid}"))
        scr.load()
        r = scr.exports_sync.init(AGENT_OPTS)
        if spawn_pid is not None:
            # spawn-gating 关键时序: attach + init 全部完成才放行进程
            device.resume(spawn_pid)
            wlog(f"[spawn] resume pid={spawn_pid}")
            if r == "no-dlopen":
                wlog("[spawn][!] init 返回 no-dlopen (找不到 dlopen 符号), "
                     "目标 SO 加载时可能无法自动 hook")
        wlog(f"init -> {r}")
    except Exception as _e:
        if spawn_pid is not None:
            try: device.kill(spawn_pid)
            except Exception: pass
        # P0-6: pull last logcat + tombstone, run diagnostic, output hints
        from tracemiku_diag import diagnose_trace_failure
        wlog(f"[!] attach/init 失败: {type(_e).__name__}: {_e}")
        try:
            lc = subprocess.run(["adb", "shell", "logcat", "-d", "-t", "200"],
                                capture_output=True, text=True, timeout=10).stdout or ""
        except Exception: lc = ""
        try:
            ts_ls = subprocess.run(
                ["adb", "shell", "ls", "-t", "/data/tombstones/"],
                capture_output=True, text=True, timeout=5).stdout or ""
            latest = ts_ls.splitlines()[0].strip() if ts_ls.strip() else ""
            if latest:
                tb = subprocess.run(
                    ["adb", "shell", "cat", f"/data/tombstones/{latest}"],
                    capture_output=True, text=True, timeout=10).stdout or ""
            else: tb = ""
        except Exception: tb = ""
        cli_flags = {
            "trace_deep": bool(getattr(args, "trace_deep", False)),
            "patch_suicide": bool(getattr(args, "patch_suicide", False)),
            "hide_rwx_maps": bool(getattr(args, "hide_rwx_maps", False)),
            "jni_hooks": getattr(args, "jni_hooks", None),
            "semantic_events": bool(getattr(args, "semantic_events", False)),
            "simd_sidecar": bool(getattr(args, "simd_sidecar", False)),
            "simd_sample_stride": max(1, int(getattr(args, "simd_sample_stride", 1) or 1)),
        }
        for h in diagnose_trace_failure(logcat=lc, tombstone=tb,
                                          exception=_e, cli_args=cli_flags):
            wlog(h)
        if spawn_gating_active:
            try: device.disable_spawn_gating()
            except Exception: pass
        log_fp.close(); return 2

    stop = [False]
    signal.signal(signal.SIGINT, lambda *_: stop.__setitem__(0, True))
    t0 = time.time()
    while not stop[0] and time.time() - t0 < args.duration:
        time.sleep(0.5)

    wlog("teardown")
    # Frida RPC sync calls 没有 timeout, 在 anti-debug 把 agent 干掉后会永远 block.
    # 全部包到 daemon thread, 主线程最多等 5s 就放弃.
    def _try_with_timeout(fn, label, timeout=5):
        import threading
        done = [False]
        def _t():
            try: fn(); done[0] = True
            except: done[0] = True
        th = threading.Thread(target=_t, daemon=True); th.start(); th.join(timeout)
        if not done[0]: wlog(f"[!] {label} 超时 {timeout}s, 放弃 (agent 可能已死)")
    _try_with_timeout(lambda: print(f"stats:", scr.exports_sync.stats(), flush=True), "stats")
    _try_with_timeout(lambda: scr.exports_sync.force_flush(), "force_flush")
    _try_with_timeout(lambda: scr.unload(), "scr.unload")
    _try_with_timeout(lambda: sess.detach(), "sess.detach")
    # P1-C M2: tear down child sessions (best-effort; some children may already exited)
    for cpid, cs in list(child_sessions.items()):
        _try_with_timeout(lambda cs=cs: cs["scr"].exports_sync.force_flush(),
                           f"child{cpid} flush", timeout=2)
        _try_with_timeout(lambda cs=cs: cs["scr"].unload(), f"child{cpid} unload", timeout=2)
        _try_with_timeout(lambda cs=cs: cs["sess"].detach(), f"child{cpid} detach", timeout=2)

    # 任何 teardown 时仍未结束的 call → 强制关 + 标 truncated
    pending = list(sess_files.values())
    for s in pending:
        s["meta"].setdefault("ts_out", time.time())
        s["meta"].setdefault("ms", int((s["meta"]["ts_out"] - s["meta"].get("ts_in", s["meta"]["ts_out"]))*1000))
        finalize_call(s, truncated=True)
    sess_files.clear()

    # 重新扫一遍 calls/, 写顶层 meta
    calls_summary = []
    all_fork_events = []   # P1-C M5: 聚合用
    for cd in sorted(CALLS_DIR.iterdir()):
        if not cd.is_dir(): continue
        mp = cd/"meta.json"
        if not mp.exists(): continue
        cm = json.load(open(mp))
        call_summary = {
            "callIdx": cm.get("callIdx"), "tid": cm.get("tid"),
            "records": cm.get("records", 0), "ms": cm.get("ms"),
            "retval": cm.get("retval"), "truncated": cm.get("truncated", True),
            "last_insn_is_ret": cm.get("last_insn_is_ret"),
            "dir": cd.name,
        }
        if cm.get("simd_sidecar") is not None:
            call_summary["simd_sidecar"] = cm.get("simd_sidecar")
        if cm.get("semantic_events_count") is not None:
            call_summary["semantic_events_count"] = cm.get("semantic_events_count")
        if cm.get("worker_events_count") is not None:
            call_summary["worker_events_count"] = cm.get("worker_events_count")
        if cm.get("worker_trace_sidecars") is not None:
            call_summary["worker_trace_sidecars"] = cm.get("worker_trace_sidecars")
        calls_summary.append(call_summary)
        for ev in (cm.get("fork_events") or []):
            all_fork_events.append((cd.name, ev))
    top_meta["calls"] = calls_summary
    top_meta["stopped_at"] = time.time()
    json.dump(top_meta, open(OUT/"meta.json","w"), indent=2)
    log_fp.close()

    total_recs = sum(c["records"] for c in calls_summary)
    print(f"\n[完成] {len(calls_summary)} 个 call, 共 {total_recs} 条记录 → {OUT}")
    for c in sorted(calls_summary, key=lambda c: -c["records"])[:10]:
        flag = "✓" if (not c["truncated"] and c["last_insn_is_ret"]) else "?"
        print(f"  {flag} {c['dir']}  ret={c.get('retval')}")

    # P1-C M5: fork summary table — 聚合所有 fork-event 按 attach_status + is_fork_like
    if all_fork_events:
        _print_fork_summary(all_fork_events)

    # P0-6 extension: if trace finished with NO successful call (every call
    # truncated or zero records), run anti-debug diagnostic on latest tombstone.
    has_success = any(not c["truncated"] and c["records"] > 1000
                       for c in calls_summary)
    if not has_success and len(calls_summary) > 0:
        _post_trace_diagnose(args, wlog)
    if spawn_gating_active:
        try: device.disable_spawn_gating()
        except Exception as e: wlog(f"[!] disable_spawn_gating 失败: {e}")
    return 0


def _post_trace_diagnose(args, wlog):
    """P0-6: when trace died mid-flight (init succeeded but no clean call recovered),
    pull latest tombstone + diagnose. Reuses tracemiku_diag.diagnose_trace_failure."""
    from tracemiku_diag import diagnose_trace_failure
    try:
        ts_ls = subprocess.run(["adb", "shell", "ls", "-t", "/data/tombstones/"],
                                capture_output=True, text=True, timeout=5).stdout or ""
        latest = ts_ls.splitlines()[0].strip() if ts_ls.strip() else ""
        if not latest: return
        tb = subprocess.run(["adb", "shell", "cat",
                              f"/data/tombstones/{latest}"],
                             capture_output=True, text=True, timeout=10).stdout or ""
    except Exception: tb = ""
    try:
        lc = subprocess.run(["adb", "shell", "logcat", "-d", "-t", "200"],
                             capture_output=True, text=True, timeout=10).stdout or ""
    except Exception: lc = ""
    cli_flags = {
        "trace_deep": bool(getattr(args, "trace_deep", False)),
        "patch_suicide": bool(getattr(args, "patch_suicide", False)),
        "hide_rwx_maps": bool(getattr(args, "hide_rwx_maps", False)),
        "jni_hooks": getattr(args, "jni_hooks", None),
        "semantic_events": bool(getattr(args, "semantic_events", False)),
        "simd_sidecar": bool(getattr(args, "simd_sidecar", False)),
        "simd_sample_stride": max(1, int(getattr(args, "simd_sample_stride", 1) or 1)),
    }
    hints = diagnose_trace_failure(logcat=lc, tombstone=tb, cli_args=cli_flags)
    if hints:
        print("\n=== Trace 死前诊断 (P0-6) ===")
        for h in hints: print(h)


def cmd_finalize(args):
    """扫 traces/<run>/calls/_pending_call_* 把残留目录补 meta + 重命名.

    用于 anti-debug 把 frida RPC 卡死, 主进程被 kill 后残留 _pending_call_NNN
    的恢复. 不需要重跑 trace.
    """
    base = pathlib.Path(args.path)
    if not base.exists(): print(f"[!] {base} 不存在"); return 1
    targets = []
    if (base/"calls").exists():
        targets.extend(p for p in (base/"calls").iterdir()
                       if p.is_dir() and p.name.startswith("_pending_call_"))
    n_done = 0
    for d in targets:
        bin_path = d/"trace.bin"
        if not bin_path.exists(): continue
        n, first_pc, last_pc, last_inst = _read_trace_tail(bin_path)
        last_is_ret = None
        if last_inst is not None:
            last_is_ret, _ = _decode_last_inst(last_pc, last_inst)
        # parse callIdx from dirname _pending_call_NNN
        try: call_idx = int(d.name.split("_")[-1])
        except: call_idx = 0
        # try existing meta.json (probably absent since trace-end never came)
        md_existing = {}
        if (d/"meta.json").exists():
            try: md_existing = json.load(open(d/"meta.json"))
            except: pass
        md = {
            "callIdx": md_existing.get("callIdx", call_idx),
            "tid": md_existing.get("tid", 0),
            "records": n,
            "ms": md_existing.get("ms"),
            "retval": None,
            "truncated": True,
            "first_pc": hex(first_pc) if first_pc else None,
            "last_pc":  hex(last_pc)  if last_pc  else None,
            "last_insn_is_ret": last_is_ret,
            "recovered": True,
        }
        ms_v = md.get("ms"); ms_str = "?ms" if ms_v is None else f"{int(ms_v)}ms"
        new_name = f"_truncated_call_{md['callIdx']:03d}_tid{md['tid']}_{n}r_{ms_str}"
        new_dir = d.parent / new_name
        if new_dir.exists():
            new_dir = d.parent / (new_name + "_recovered")
        try:
            d.rename(new_dir)
            json.dump(md, open(new_dir/"meta.json","w"), indent=2)
            n_done += 1
            print(f"  recovered: {new_dir.name} ({n} 条)")
        except Exception as e:
            print(f"  failed: {d.name}: {e}")
    # 顶层 meta.json: 如果不存在或缺 calls[], 重建之 (从 calls/ 子目录扫)
    top_path = base / "meta.json"
    top_meta = {}
    if top_path.exists():
        try: top_meta = json.load(open(top_path))
        except: pass
    summary = []
    for cd in sorted((base/"calls").iterdir()) if (base/"calls").exists() else []:
        if not cd.is_dir(): continue
        mp = cd/"meta.json"
        if not mp.exists(): continue
        try: cm = json.load(open(mp))
        except: continue
        summary.append({"callIdx": cm.get("callIdx"), "tid": cm.get("tid"),
                        "records": cm.get("records",0), "ms": cm.get("ms"),
                        "retval": cm.get("retval"),
                        "truncated": cm.get("truncated", True),
                        "last_insn_is_ret": cm.get("last_insn_is_ret"),
                        "dir": cd.name})
    top_meta["calls"] = summary
    top_meta.setdefault("per_call", True)
    json.dump(top_meta, open(top_path, "w"), indent=2)
    print(f"[完成] 恢复 {n_done} 个 _pending_call_*; 顶层 meta.json 已重写 ({len(summary)} calls)")
    return 0


