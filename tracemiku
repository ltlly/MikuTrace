def _list_runs(base, args):
    rows = []
    for sub in sorted(base.iterdir()):
        if not sub.is_dir(): continue
        meta_f = sub/"meta.json"
        meta = json.load(open(meta_f)) if meta_f.exists() else {}
        # per-call run
        calls_dir = sub/"calls"
        if calls_dir.exists():
            calls_meta = []
            for cd in calls_dir.iterdir():
                if not cd.is_dir(): continue
                mp = cd/"meta.json"
                if mp.exists():
                    try: calls_meta.append(json.load(open(mp)))
                    except: pass
            n_calls = len(calls_meta)
            total_recs = sum(c.get("records", 0) for c in calls_meta)
            max_recs = max((c.get("records", 0) for c in calls_meta), default=0)
            rows.append({
                "name": sub.name, "method": meta.get("method"), "cmd": meta.get("cmd"),
                "calls": n_calls, "records": total_recs, "max_records": max_recs,
                "kind": "per-call",
            })
        else:
            # legacy flat layout
            bins = list(sub.glob("trace_*.bin"))
            total = sum(b.stat().st_size for b in bins)
            rows.append({
                "name": sub.name, "method": meta.get("method"), "cmd": meta.get("cmd"),
                "calls": len(bins), "records": total//272, "max_records": total//272,
                "kind": "legacy",
            })
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False)); return 0
    print(f"{'name':<40s}  {'method':<18s}  {'cmd':>6s}  {'calls':>5s}  {'records':>10s}  {'max':>10s}  kind")
    for r in rows:
        print(f"{r['name']:<40s}  {str(r['method'] or '-'):<18s}  "
              f"{str(r['cmd'] or '-'):>6s}  {r['calls']:>5d}  "
              f"{r['records']:>10d}  {r['max_records']:>10d}  {r['kind']}")
    return 0


def _list_calls(run_dir, args):
    calls_dir = run_dir/"calls"
    rows = []
    if calls_dir.exists():
        for cd in calls_dir.iterdir():
            if not cd.is_dir(): continue
            mp = cd/"meta.json"
            if not mp.exists(): continue
            cm = json.load(open(mp))
            cm["dir"] = cd.name
            rows.append(cm)
    else:
        # legacy: 单 run 多 trace_*.bin
        for b in sorted(run_dir.glob("trace_*.bin")):
            rows.append({
                "callIdx": None, "tid": None,
                "records": b.stat().st_size // 272,
                "dir": b.name, "truncated": None, "last_insn_is_ret": None,
            })
    rows.sort(key=lambda r: -(r.get("records") or 0))
    if args.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False)); return 0
    print(f"{'#':>4s}  {'tid':>7s}  {'records':>10s}  {'ms':>7s}  ret      ✓  dir")
    for r in rows:
        complete = (r.get("truncated") is False) and (r.get("last_insn_is_ret") is True)
        flag = "✓" if complete else ("✗" if r.get("truncated") else "?")
        ci  = r.get("callIdx")
        ci_s = f"{ci:>4d}" if isinstance(ci, int) else "   ?"
        tid = r.get("tid"); tid_s = f"{tid:>7d}" if isinstance(tid, int) else "      ?"
        ms_v = r.get("ms"); ms_s = f"{ms_v:>7d}" if isinstance(ms_v, int) else "      ?"
        recs = r.get("records") or 0
        ret = (r.get("retval") or "-")[:8]
        print(f"{ci_s}  {tid_s}  {recs:>10d}  {ms_s}  {ret:<8s} {flag}  {r['dir']}")
    return 0


def cmd_info(args):
    """3 种路径形式:
    - run 目录 (含 calls/) → 顶层概要 + 各 call 概要
    - call 目录 (含 trace.bin + meta.json) → 单 call 完整性
    - 旧 run 目录 (trace_*.bin) → 兼容旧逻辑
    """
    p = pathlib.Path(args.path)
    if not p.exists():
        print(f"[!] 路径不存在: {p}"); return 1

    # call 目录
    if (p/"trace.bin").exists():
        return _info_call(p, args)

    # run 目录 (per-call)
    if (p/"calls").exists():
        return _info_run(p, args)

    # 旧 layout fallback
    from viewer.trace import load
    t = load(p)
    out = {
        "path": str(p), "records": len(t),
        "module": {"name": t.meta.module.name, "base": hex(t.meta.module.base),
                   "size": t.meta.module.size} if t.meta.module else None,
        "method": t.meta.method, "cmd": t.meta.cmd,
