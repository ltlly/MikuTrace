#!/usr/bin/env python3
"""tracemiku — Android ARM64 trace 采集与离线 JSON 分析的统一入口。"""
import json
import os
import pathlib
import subprocess
import sys
import time
from contextlib import suppress

from tracemiku_commands import build_parser, capabilities_response, command_parsers
from tracemiku_device import _check_device
from tracemiku_target import apply_target, load_target

HERE = pathlib.Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

def _rust_cli_cmd(args):
    bin_path = os.environ.get("TRACEMIKU_CLI_BIN")
    if bin_path:
        return [bin_path, *args]
    debug_bin = HERE / "rust" / "target" / "debug" / "tracemiku-cli"
    if debug_bin.exists():
        return [str(debug_bin), *args]
    return [
        "cargo", "run", "--quiet", "--manifest-path", str(HERE / "rust" / "Cargo.toml"),
        "-p", "tracemiku-cli", "--bin", "tracemiku-cli", "--", *args,
    ]


def _run_rust_cli(args):
    return subprocess.call(_rust_cli_cmd(args))


def _rust_cli_json(args):
    r = subprocess.run(_rust_cli_cmd(args), capture_output=True, text=True, check=False)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or r.stdout.strip() or f"tracemiku-cli exited {r.returncode}")
    return json.loads(r.stdout)


def _capture_result(args, recover=False):
    from tracemiku_capture import capture
    from tracemiku_spool import recover_run
    out = pathlib.Path(args.run if recover else args.out).resolve()
    def log(message):
        print(f"[{time.strftime('%H:%M:%S')}] {message}", file=sys.stderr, flush=True)
    try:
        result = (recover_run(out, _rust_cli_json, log=log) if recover else
                  capture(args, HERE, _rust_cli_json, log))
    except Exception as exc:  # noqa: BLE001 -- CLI 边界统一序列化 Frida、设备和文件异常
        result = {"schema_version": 1, "status": "error", "out": str(out),
                  "calls": [], "pending": [], "error": {
                      "code": "recovery_failed" if recover else "capture_failed",
                      "message": str(exc)[:2000]}}
    print(json.dumps(result, ensure_ascii=False), flush=True)
    return 0 if result["status"] == "ok" else 2


def cmd_trace(args):
    return _capture_result(args)


def cmd_doctor(args):
    """Pre-flight device check for trace readiness."""
    print("[doctor] 检查设备 trace 前置条件...\n")
    ok, fail, _results = _check_device(pkg=args.pkg, out_dir=args.out, verbose=True)
    print(f"\n{'='*40}")
    if fail == 0:
        print(f"  所有检查通过 ({ok}/{ok})")
        return 0
    else:
        print(f"  {ok} 通过, {fail} 失败 — 请修复上述问题后再执行 trace")
        return 1


def cmd_probe(args):
    """Lightweight Interceptor-based export profiling (no Stalker, no trace)."""
    try:
        import frida
    except ImportError:
        print("[!] frida module not found. pip install frida", file=sys.stderr)
        return 1

    so_pattern = args.so
    duration = args.duration
    top_n = args.top
    filter_pat = args.filter

    # Connect to device (USB default, --remote optional)
    mgr = frida.get_device_manager()
    if args.remote:
        device = mgr.add_remote_device(args.remote)
    else:
        device = frida.get_usb_device(timeout=10)
    print(f"[probe] device={device}", flush=True)

    # Attach
    if args.attach_pid:
        session = device.attach(args.attach_pid)
        print(f"[probe] attached pid={args.attach_pid}", flush=True)
    elif args.pkg:
        pids = [p.pid for p in device.enumerate_processes() if args.pkg in p.name]
        if not pids:
            print(f"[!] no running process matching '{args.pkg}'", file=sys.stderr)
            return 1
        session = device.attach(pids[0])
        print(f"[probe] attached {args.pkg} pid={pids[0]}", flush=True)
    else:
        print("[!] probe requires --pkg or --attach-pid", file=sys.stderr)
        return 1

    # Frida script: Interceptor attach on matching exports, count + timing
    # Template substitution for parameters
    js_src = f"""'use strict';
const soPattern = {json.dumps(so_pattern)};
const filterPat = {json.dumps(filter_pat) if filter_pat else 'null'};
const duration  = {duration};

const stats = {{}};

function matchModule(m) {{
    return m.name.indexOf(soPattern) >= 0 || m.path.indexOf(soPattern) >= 0;
}}

const mods = Process.enumerateModules().filter(matchModule);
if (mods.length === 0) {{
    send({{ type: 'error', msg: 'No module matching ' + soPattern }});
}} else {{
    let hooked = 0;
    for (const mod of mods) {{
        const exports = mod.enumerateExports().filter(e => e.type === 'function');
        for (const exp of exports) {{
            if (filterPat && exp.name.indexOf(filterPat) < 0) continue;
            const name = mod.name + '!' + exp.name;
            stats[name] = {{ count: 0, totalNs: 0 }};
            try {{
                Interceptor.attach(exp.address, {{
                    onEnter(a) {{ this._t0 = Date.now(); }},
                    onLeave(r) {{
                        const s = stats[name];
                        s.count++;
                        s.totalNs += (Date.now() - this._t0) * 1e6;
                    }}
                }});
                hooked++;
            }} catch (e) {{ /* skip non-hookable */ }}
        }}
    }}
    send({{ type: 'status', msg: 'Hooked ' + hooked + ' exports in ' + mods.map(m=>m.name).join(',') }});
}}

setTimeout(() => {{
    const arr = Object.entries(stats)
        .filter(([_, v]) => v.count > 0)
        .map(([name, v]) => ({{ name, count: v.count, avgMs: v.totalNs / v.count / 1e6 }}))
        .sort((a, b) => b.count - a.count);
    send({{ type: 'result', data: arr }});
}}, duration * 1000);
"""

    result_data = []
    finished = [False]

    def on_message(msg, _data):
        if msg["type"] == "send":
            p = msg["payload"]
            if p["type"] == "status":
                print(f"[probe] {p['msg']}", flush=True)
            elif p["type"] == "error":
                print(f"[probe] ERROR: {p['msg']}", file=sys.stderr, flush=True)
                finished[0] = True
            elif p["type"] == "result":
                result_data.extend(p["data"])
                finished[0] = True

    script = session.create_script(js_src, runtime="v8")
    script.on("message", on_message)
    script.load()

    print(f"[probe] profiling for {duration}s ... (Ctrl+C to stop early)", flush=True)
    try:
        t0 = time.time()
        while not finished[0] and (time.time() - t0) < duration + 5:
            time.sleep(0.5)
    except KeyboardInterrupt:
        pass
    finally:
        with suppress(Exception):
            script.unload()
        with suppress(Exception):
            session.detach()

    if not result_data:
        print("[probe] no calls recorded.", flush=True)
        return 0

    # Print results
    print(f"\n{'─'*70}", flush=True)
    print(f"{'Name':<50} {'Calls':>8} {'Avg(ms)':>10}", flush=True)
    print(f"{'─'*70}", flush=True)
    for item in result_data[:top_n]:
        print(f"{item['name']:<50} {item['count']:>8} {item['avgMs']:>10.3f}", flush=True)
    if len(result_data) > top_n:
        print(f"  ... and {len(result_data) - top_n} more", flush=True)
    print(f"{'─'*70}", flush=True)
    print(f"Total exports with hits: {len(result_data)}", flush=True)

    # JSON output
    if args.json:
        print(json.dumps(result_data, ensure_ascii=False, indent=2))

    return 0


def main():
    ap = build_parser()
    if len(sys.argv) > 1:
        first = sys.argv[1]
        if first in ("-V", "--version") or (
                not first.startswith("-") and first not in command_parsers(ap)):
            return _run_rust_cli(sys.argv[1:])
    args = ap.parse_args()
    if args.subcommand == "capabilities":
        try:
            result, code = capabilities_response(ap, _rust_cli_json(["capabilities"]), args.command)
        except (RuntimeError, OSError) as exc:
            print(f"[!] 能力发现失败: {exc}", file=sys.stderr)
            return 1
        print(json.dumps(result, ensure_ascii=False))
        return code
    if args.subcommand == "trace" and args.target_profile:
        try:
            profile = load_target(args.target_profile)
            explicit = {token.split("=", 1)[0][2:].replace("-", "_")
                        for token in sys.argv[2:] if token.startswith("--")}
            apply_target(args, profile, explicit)
            args._target_profile = profile
        except (ValueError, OSError) as exc:
            ap.error(str(exc))
    if args.subcommand == "trace":
        return cmd_trace(args)
    if args.subcommand == "recover":
        return _capture_result(args, recover=True)
    if args.subcommand == "probe":
        return cmd_probe(args)
    if args.subcommand == "doctor":
        return cmd_doctor(args)
    ap.print_help()
    return 1


if __name__ == "__main__":
    sys.exit(main())
