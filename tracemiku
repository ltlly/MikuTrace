            a = int(a_) if a_ else 0
            b = int(b_) if b_ else len(t)
        regs_filter = args.regs.split(",") if args.regs else None
        rows = []
        for i in range(a, min(b, len(t))):
            r = t.record(i); d = decode(r.pc, r.inst)
            fname, foff = sym.lookup(r.pc)
            row = {
                "idx": i, "pc": hex(r.pc), "rel": hex(r.pc - base) if base else None,
                "func": fname if fname != "?" else None,
                "off": hex(foff) if fname != "?" else None,
                "asm": f"{d.mnemonic} {d.op_str}",
                "is_branch": d.is_branch, "is_call": d.is_call, "is_ret": d.is_ret,
            }
            if regs_filter:
                row["regs"] = {nm: hex(r.reg(nm)) for nm in regs_filter if nm in ALL_REGS}
            rows.append(row)
        out = {"count": len(rows), "records": rows}
    elif sub == "forward-taint":
        from viewer.taint import forward_taint
        idx = Index(t); idx.build()
        results = forward_taint(t, args.from_, args.reg, max_count=args.max, index=idx)
        rows = []
        for i, why in results:
            r = t.record(i); d = decode(r.pc, r.inst)
            fname, foff = sym.lookup(r.pc)
            rows.append({"idx": i, "pc": hex(r.pc),
                         "func": fname if fname != "?" else None,
                         "off": hex(foff) if fname != "?" else None,
                         "asm": f"{d.mnemonic} {d.op_str}", "why": why})
        out = {"count": len(rows), "from": args.from_, "reg": args.reg, "hits": rows}
    elif sub == "backward-taint":
        from viewer.taint import backward_taint
        idx = Index(t); idx.build()
        results = backward_taint(t, args.from_, args.reg, max_count=args.max, index=idx)
        rows = []
        for i, reg in results:
            r = t.record(i); d = decode(r.pc, r.inst)
            fname, foff = sym.lookup(r.pc)
            rows.append({"idx": i, "pc": hex(r.pc),
                         "func": fname if fname != "?" else None,
                         "off": hex(foff) if fname != "?" else None,
                         "asm": f"{d.mnemonic} {d.op_str}", "via": reg})
        out = {"count": len(rows), "from": args.from_, "reg": args.reg, "chain": rows}
    elif sub == "strings":
        mem = MemShadow(t); mem.build()
        results = mem.find_strings(min_len=args.min_len)
        rows = [{"addr": hex(a), "len": len(s), "str": s} for a, s in results]
        out = {"count": len(rows), "strings": rows}
    elif sub == "cfg":
        from viewer.cfg import build_cfg
        cfg = build_cfg(t, only_module=True)
        blocks = []
        for pc, b in cfg.blocks.items():
            blocks.append({
                "start": hex(pc), "end": hex(b.end_pc), "off": hex(pc-base) if base else None,
                "insns": len(b.insns), "executions": b.executions,
                "exits": [{"to": hex(t), "kind": k} for t,k in b.exits],
            })
        edges = [{"src": hex(s), "dst": hex(d), "kind": v["kind"], "count": v["count"]}
                 for (s,d), v in cfg.edges.items()]
        out = {"blocks": blocks, "edges": edges,
               "block_count": len(blocks), "edge_count": len(edges),
               "entry": hex(cfg.entry_pc)}
    elif sub == "search":
        import re
        rx = re.compile(args.pattern, re.I)
        rows = []
        for i in range(len(t)):
            r = t.record(i); d = decode(r.pc, r.inst)
            if rx.search(f"{d.mnemonic} {d.op_str}"):
                fname, foff = sym.lookup(r.pc)
                rows.append({"idx": i, "pc": hex(r.pc),
                             "func": fname if fname != "?" else None,
                             "off": hex(foff) if fname != "?" else None,
                             "asm": f"{d.mnemonic} {d.op_str}"})
                if len(rows) >= args.max: break
        out = {"count": len(rows), "pattern": args.pattern, "hits": rows}
    elif sub == "func-summary":
        # 列出 trace 里出现的所有函数
        funcs = {}
        for i in range(len(t)):
            r = t.record(i)
            fname, foff = sym.lookup(r.pc)
            if fname not in funcs:
                funcs[fname] = {"count": 0, "first_idx": i, "last_idx": i}
            funcs[fname]["count"] += 1
            funcs[fname]["last_idx"] = i
        rows = sorted([{"func": k, **v} for k, v in funcs.items()],
                      key=lambda r: -r["count"])
        out = {"functions": rows}

    if out is not None:
        if args.json:
            print(json.dumps(out, ensure_ascii=False, indent=2))
        else:
            # 简单纯文本输出
            if sub == "records":
                for r in out["records"]:
                    print(f"#{r['idx']:6d}  {r.get('func',''):<24s}+{r.get('off','')}  {r['asm']}")
            elif sub in ("forward-taint", "backward-taint"):
                key = "hits" if sub == "forward-taint" else "chain"
                for r in out[key]:
                    extra = r.get("why") or r.get("via", "")
                    print(f"#{r['idx']:6d}  {r.get('func',''):<24s}+{r.get('off','')}  {r['asm']}  ; {extra}")
            elif sub == "strings":
                for r in out["strings"]: print(f"{r['addr']}  ({r['len']:3d})  {r['str']!r}")
            elif sub == "cfg":
                print(f"blocks={out['block_count']} edges={out['edge_count']} entry={out['entry']}")
                for b in sorted(out["blocks"], key=lambda x: -x["executions"])[:30]:
                    print(f"  {b['off']:>10s} ×{b['executions']:5d}  insns={b['insns']:3d}")
            elif sub == "search":
                for r in out["hits"]: print(f"#{r['idx']:6d}  {r['off']}  {r['asm']}")
            elif sub == "func-summary":
                for r in out["functions"][:30]:
                    print(f"  {r['func']:<28s}  ×{r['count']:6d}  first=#{r['first_idx']} last=#{r['last_idx']}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="tracemiku", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="subcommand", required=True)

    # trace
    p_tr = sp.add_parser("trace", help="采集 trace")
    p_tr.add_argument("--pkg", required=False, help="目标 app 包名")
    p_tr.add_argument("--attach-pid", type=int, help="直接附加 pid")
    p_tr.add_argument("--so", required=True, help="目标 SO 名子串")
    p_tr.add_argument("--method", help="JNI 注册方法名 (动态注册)")
    p_tr.add_argument("--export", help="SO 导出函数名 (静态导出)")
    p_tr.add_argument("--fn-offset", help="SO 内函数偏移 (16进制如 0x57770)")
    p_tr.add_argument("--cmd", type=int, help="cmd id 过滤值 (默认 0=不过滤)")
    p_tr.add_argument("--cmd-arg", type=int, default=2, help="cmd id 在第几个参数 (默认 2)")
    p_tr.add_argument("--include-so", default="", dest="include_so",
                      help="逗号分隔, 额外 trace 这些 SO (除目标外). e.g."
                           " 'libsgsecuritybody,libsgavmp,libcrypto'."
                           " HARD_EXCL (libc/libart/linker etc) 永远排除 — 即使列在这里也忽略.")
    p_tr.add_argument("--trace-deep", action="store_true", dest="trace_deep",
                      help="深度模式: 不再 module-level 排除 libart/libc. 改成 per-symbol "
                           "Stalker.exclude (interpreter/JIT/GC/atomic primitives 这些 LDXR/STXR "
                           "或 ART 自修改不安全的函数). 大部分 libart 函数 (NewStringUTF / "
                           "GetField 等) 现在能被 Stalker 跟到. linker/libdl 仍整 module 排除.")
    p_tr.add_argument("--stalker-exclude-patterns", default=None, dest="stalker_exclude_patterns",
                      help="逗号分隔, 覆盖默认 Stalker.exclude 名单 (per-symbol). 仅 --trace-deep 下生效.")
    p_tr.add_argument("--boundary-diff-patterns", default=None, dest="boundary_diff_patterns",
                      help="逗号分隔, 在这些函数装 Interceptor 抓内存写 (boundary ptr-diff). "
                           "**严禁包含 pthread/malloc/atomic** — Frida 自己用这些, attach 会崩进程. "
                           "默认空. 仅 --trace-deep 下生效.")
    p_tr.add_argument("--patch-suicide", action="store_true", dest="patch_suicide",
                      help="启用 anti-anti-frida tgkill svc → nop patching. 默认 spec = "
                           "tools/hooks/sgmainso_6.8.260403_suicide.json (libsgmainso 6.8.260403). "
                           "其他 SO 版本通过 --suicide-patch-spec PATH 传 JSON. 仅 --trace-deep 下生效.")
    p_tr.add_argument("--suicide-patch-spec", default="tools/hooks/sgmainso_6.8.260403_suicide.json",
                      dest="suicide_patch_spec",
                      help="JSON spec for tgkill svc patches (offset list per SO version). 默认 "
                           "= libsgmainso 6.8.260403. 给其他 SO/版本: 写新的 spec 文件.")
    p_tr.add_argument("--hide-rwx-maps", action="store_true", dest="hide_rwx_maps",
                      help="在 libc open/read 拦截 /proc/self/maps, 过滤 rwxp 匿名段 — 让反检测"
                           "看不到 Frida Stalker block cache 的 rwx. 通用反检测绕过, 不依赖目标 SO.")
    p_tr.add_argument("--jni-hooks", default="tools/hooks/libart_jni.json", dest="jni_hooks",
                      help="JSON 描述要 hook 的 JNI vtable 函数 (offset/参数类型/返回类型). "
                           "默认 = libart string fns. 设 'none' 关闭. 输出 jni_hooks.jsonl per-call. "
                           "Interceptor 不依赖 Stalker, 给重防护 app 的备选方案 (低反检测面).")
    p_tr.add_argument("--max-records", type=int, default=5000000)
    p_tr.add_argument("--follow-workers", action="store_true",
                      help="跟踪 pthread_create 新生成的 worker 线程 (异步函数才需要; 默认关，不然 TB 类 app 易闪退)")
    p_tr.add_argument("--no-workers", action="store_true", help="(deprecated, 默认就是不跟)")
    p_tr.add_argument("--duration", type=int, default=120)
    p_tr.add_argument("--out", required=True, help="输出目录")
    p_tr.add_argument("--remote", default="127.0.0.1:6699", help="frida server 地址")
    p_tr.add_argument("--mode", choices=["js", "cmodule"], default="cmodule",
                      help="trace 实现: js=JS callout (~30K rec/s) cmodule=CModule native (10x+, 默认)")
    p_tr.add_argument("--cold-launch", action="store_true",
                      help="冷启动 app 前自动 force-stop+pm clear+monkey+点'同意' (隐私协议自动化, 多 app 通用)")
    p_tr.add_argument("--home-markers", default=None,
                      help="自定义首页文本 regex (默认: 同意按钮消失 + UI settle 即认为首页就绪)")

    # view
    p_vw = sp.add_parser("view", help="启动 TUI 查看器")
    p_vw.add_argument("path", help="trace 目录或 .bin 文件")

    # query (AI 友好)
    p_qy = sp.add_parser("query", help="JSON 查询接口")
    p_qy.add_argument("path", help="trace 目录或 .bin 文件")
    qsp = p_qy.add_subparsers(dest="sub", required=True)
    # add --json to every subparser uniformly
    def _addj(sub):
        sub.add_argument("--json", action="store_true", help="输出 JSON"); return sub
    q_r = _addj(qsp.add_parser("records", help="按范围导出指令记录"))
    q_r.add_argument("--range", help="范围 a..b (默认全部)"); q_r.add_argument("--regs", help="逗号分隔的寄存器名")
    q_ft = _addj(qsp.add_parser("forward-taint", help="正向污点"))
    q_ft.add_argument("--from", dest="from_", type=int, required=True); q_ft.add_argument("--reg", required=True); q_ft.add_argument("--max", type=int, default=500)
    q_bt = _addj(qsp.add_parser("backward-taint", help="反向污点"))
    q_bt.add_argument("--from", dest="from_", type=int, required=True); q_bt.add_argument("--reg", required=True); q_bt.add_argument("--max", type=int, default=500)
    q_st = _addj(qsp.add_parser("strings", help="字符串提取")); q_st.add_argument("--min-len", type=int, default=4)
    q_cfg = _addj(qsp.add_parser("cfg", help="CFG 数据"))
    q_se = _addj(qsp.add_parser("search", help="按反汇编 regex 搜"))
    q_se.add_argument("--pattern", required=True); q_se.add_argument("--max", type=int, default=200)
    q_fs = _addj(qsp.add_parser("func-summary", help="函数命中频次"))

    # list
    p_ls = sp.add_parser("list", help="列出已有 trace (无参=列 runs, <run>=列 calls 降序)")
    p_ls.add_argument("path", nargs="?", help="可选: 某 run 目录, 列出其中的 calls (records 降序)")
    p_ls.add_argument("--dir", help="trace 根目录 (默认 traces/)")
    p_ls.add_argument("--json", action="store_true")

    # info
    p_in = sp.add_parser("info", help="trace 元信息")
    p_in.add_argument("path", help="trace 目录")
    p_in.add_argument("--json", action="store_true")

    # finalize (recover _pending_call_*)
    p_fz = sp.add_parser("finalize", help="扫 run/calls/_pending_call_* 补 meta + 重命名 (恢复中断的 trace)")
    p_fz.add_argument("path", help="run 目录")

    # web (single-page IDA-style SPA, 推荐替代 view)
    p_web = sp.add_parser("web", help="单页 SPA: 左 trace + 右 CFG, IDA 风格分屏 (默认推荐)")
    p_web.add_argument("path", help="trace 目录 (run 或 per-call)")
    p_web.add_argument("--host", default="0.0.0.0")
    p_web.add_argument("--port", type=int, default=0, help="0=自动")
    p_web.add_argument("--no-browser", action="store_true", help="不自动打开浏览器")
    p_web.add_argument("--so", default=None,
                       help="SO 文件路径 (启用 HLIL 反编译 tab; 启动时后台加载)")
    p_web.add_argument("--decomp", default=None,
                       choices=("binja", "ghidra", "none"),
                       help="反编译后端 (默认按可用性自动选)")

    args = ap.parse_args()
    if args.subcommand == "trace":   return cmd_trace(args)
    if args.subcommand == "view":    return cmd_view(args)
    if args.subcommand == "query":   return cmd_query(args)
    if args.subcommand == "list":    return cmd_list(args)
    if args.subcommand == "info":    return cmd_info(args)
    if args.subcommand == "finalize":return cmd_finalize(args)
    if args.subcommand == "web":     return cmd_web(args)
    ap.print_help(); return 1


if __name__ == "__main__":
    sys.exit(main())
