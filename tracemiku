def _info_call(p, args):
    """单 call 目录: 重新解码 last insn 并核对 last_insn_is_ret."""
    meta = {}
    mp = p/"meta.json"
    if mp.exists():
        meta = json.load(open(mp))
    bin_path = p/"trace.bin"
    n, first_pc, last_pc, last_inst = _read_trace_tail(bin_path)
    last_is_ret = None
    last_asm = None
    if last_inst is not None:
        last_is_ret, last_asm = _decode_last_inst(last_pc, last_inst)
    truncated = bool(meta.get("truncated", False))
    complete = (not truncated) and last_is_ret
    out = {
        "path": str(p),
        "callIdx": meta.get("callIdx"),
        "tid": meta.get("tid"),
        "records": n,
        "ms": meta.get("ms"),
        "retval": meta.get("retval"),
        "truncated": truncated,
        "last_insn_is_ret": last_is_ret,
        "first_pc": hex(first_pc) if first_pc is not None else None,
        "last_pc":  hex(last_pc)  if last_pc  is not None else None,
        "last_asm": last_asm,
        "is_complete": bool(complete),
    }
    # rate sanity
    ms = meta.get("ms")
    if isinstance(ms, (int, float)) and ms > 0:
        out["rec_per_sec"] = int(n / (ms/1000.0))
    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=2))
    else:
        flag = "✓ 完整" if complete else ("✗ 截断" if truncated else "? 未结束/未 ret")
        print(f"路径:   {p}")
        print(f"call#:  {out['callIdx']}  tid={out['tid']}")
        print(f"记录:   {n} 条" + (f"  ({out['rec_per_sec']} rec/s)" if "rec_per_sec" in out else ""))
        print(f"用时:   {ms} ms")
        print(f"返回值: {out['retval']}")
        print(f"truncated:        {truncated}")
        print(f"last_insn_is_ret: {last_is_ret}")
        print(f"first_pc: {out['first_pc']}")
        print(f"last_pc:  {out['last_pc']}  ({last_asm})")
        print(f"完整性:  {flag}")
    return 0


def _info_run(p, args):
    top = {}
    if (p/"meta.json").exists():
        top = json.load(open(p/"meta.json"))
    calls_dir = p/"calls"
    calls = []
    for cd in sorted(calls_dir.iterdir()):
        if not cd.is_dir(): continue
        mp = cd/"meta.json"
        if not mp.exists(): continue
        cm = json.load(open(mp)); cm["dir"] = cd.name
        calls.append(cm)
    calls.sort(key=lambda c: -(c.get("records") or 0))
    out = {
        "path": str(p),
        "pkg": top.get("pkg"), "so": top.get("so"),
        "method": top.get("method"), "cmd": top.get("cmd"),
        "fn_offset": top.get("fn_offset"), "fn_addr": top.get("fn_addr"),
        "module": top.get("module"),
        "calls_count": len(calls),
        "total_records": sum(c.get("records",0) for c in calls),
        "max_records":   max((c.get("records",0) for c in calls), default=0),
        "calls": calls,
    }
    if args.json:
        print(json.dumps(out, ensure_ascii=False, indent=2)); return 0
    print(f"路径:    {p}")
    print(f"pkg/so:  {out['pkg']} / {out['so']}")
    print(f"method:  {out['method']}  cmd={out['cmd']}  fn={out['fn_addr']}")
    print(f"calls:   {out['calls_count']}, 总 {out['total_records']} 条, 最长 {out['max_records']}")
    print()
    for c in calls[:30]:
        complete = (c.get("truncated") is False) and (c.get("last_insn_is_ret") is True)
        flag = "✓" if complete else ("✗" if c.get("truncated") else "?")
        print(f"  {flag} call#{c.get('callIdx')}  tid={c.get('tid')}  recs={c.get('records')}  "
              f"ms={c.get('ms')}  ret={c.get('retval')}  {c['dir']}")
    return 0


def cmd_query(args):
    """Legacy JSON query facade backed by Rust v2 CLI route wrappers."""
    path = args.path
    sub = args.sub
    if sub == "records":
        start = 0
        count = 100
        if args.range:
            a, b = args.range.split("..")
            start = int(a) if a else 0
            if b:
                count = max(0, int(b) - start)
        cmd = ["records", path, "--start", str(start), "--count", str(count)]
        if args.regs:
            cmd += ["--regs", args.regs]
        return _run_rust_cli(cmd)
    if sub == "forward-taint":
        return _run_rust_cli([
            "taint-fwd", path, "--start", str(args.from_), "--reg", args.reg,
            "--max-count", str(args.max),
        ])
    if sub == "backward-taint":
        if args.from_ is None and not (args.so and args.off):
            print("[!] backward-taint 需要 --from <idx> 或 (--so + --off)", file=sys.stderr)
            return 2
        cmd = ["taint-bwd", path, "--reg", args.reg, "--max-count", str(args.max)]
        if args.from_ is not None:
            cmd += ["--start", str(args.from_)]
        if args.so:
            cmd += ["--so", args.so]
        if args.off:
            cmd += ["--off", args.off]
        if args.occurrence:
            cmd += ["--occurrence", str(args.occurrence)]
        return _run_rust_cli(cmd)
    if sub == "strings":
        return _run_rust_cli(["strings", path, "--min-len", str(args.min_len)])
    if sub == "cfg":
        return _run_rust_cli(["cfg", path])
    if sub == "search":
        pattern = args.pattern or args.pattern_flag
        if not pattern:
            print("[!] search 需要 pattern (位置参数或 --pattern)", file=sys.stderr); return 2
        return _run_rust_cli(["search", path, pattern, "--max-results", str(args.max)])
    if sub == "func-summary":
        return _run_rust_cli(["functions", path])
    if sub == "resolve":
        if not args.addr and not (args.so and args.off):
            print("[!] resolve 需要 --addr 0x.. 或 (--so <名> --off <偏移>)", file=sys.stderr)
            return 2
        cmd = ["resolve", path]
        if args.addr:
            cmd += ["--addr", args.addr]
        if args.so:
            cmd += ["--so", args.so]
        if args.off:
            cmd += ["--off", args.off]
        return _run_rust_cli(cmd)
    if sub == "indirect-targets":
        cmd = ["indirect-targets", path]
        if args.addr:
            cmd += ["--addr", args.addr]
        if args.so:
            cmd += ["--so", args.so]
        if args.off:
            cmd += ["--off", args.off]
        if args.min_count is not None:
            cmd += ["--min-count", str(args.min_count)]
        return _run_rust_cli(cmd)
    if sub == "mem-export":
        if not args.addr and not (args.so and args.off):
            print("[!] mem-export 需要 --addr 或 (--so + --off)", file=sys.stderr)
            return 2
        cmd = ["mem-export", path, "--len", args.len]
        if args.addr:
            cmd += ["--addr", args.addr]
        if args.so:
            cmd += ["--so", args.so]
        if args.off:
            cmd += ["--off", args.off]
        if args.cursor is not None:
            cmd += ["--cursor", str(args.cursor)]
        if args.out:
            cmd += ["--out", args.out]
        return _run_rust_cli(cmd)
    if sub == "reg-at":
        if not args.addr and not (args.so and args.off):
            print("[!] reg-at 需要 --addr 或 (--so + --off)", file=sys.stderr)
            return 2
        cmd = ["reg-at", path, "--reg", args.reg]
        if args.addr:
            cmd += ["--addr", args.addr]
        if args.so:
            cmd += ["--so", args.so]
        if args.off:
            cmd += ["--off", args.off]
        if args.max is not None:
            cmd += ["--max", str(args.max)]
        return _run_rust_cli(cmd)
    if sub == "coverage":
        if not args.addr and not (args.so and args.off) and not args.fn_name:
            print("[!] coverage 需要 --addr / (--so + --off) / --fn", file=sys.stderr)
            return 2
        cmd = ["coverage", path]
        if args.addr:
            cmd += ["--addr", args.addr]
        if args.so:
            cmd += ["--so", args.so]
        if args.off:
            cmd += ["--off", args.off]
        if args.fn_name:
            cmd += ["--fn", args.fn_name]
        return _run_rust_cli(cmd)
    print(f"[!] unsupported query subcommand: {sub}", file=sys.stderr)
    return 2


