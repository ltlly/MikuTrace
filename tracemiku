    - tracemiku list / list --dir traces : 列所有 run
    - tracemiku list <run> : 列该 run 下的 calls (records 降序)
    """
    target = pathlib.Path(args.path) if getattr(args, "path", None) else pathlib.Path(args.dir or "traces")
