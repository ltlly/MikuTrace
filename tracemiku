def cmd_dec(args):
    """Rust v2 TraceIR markdown wrapper."""
    p = pathlib.Path(args.path)
    if not p.exists():
        print(f"[!] path 不存在: {p}", file=sys.stderr); return 1
    if args.summary:
        v = _rust_cli_json(["dec-summary", str(p)])
        sys.stdout.write(v.get("summary_md", ""))
        return 0
    if args.fn:
        v = _rust_cli_json(["dec-fn", str(p), args.fn, "--tier", args.tier])
        sys.stdout.write(v.get("markdown", ""))
        return 0

    summary = _rust_cli_json(["dec-summary", str(p)])
    out_root = pathlib.Path(args.out) if args.out else p
    dec_dir = out_root / "decompile"
    fns_dir = dec_dir / "fns"
    fns_dir.mkdir(parents=True, exist_ok=True)
    (dec_dir / "summary.md").write_text(summary.get("summary_md", ""), encoding="utf-8")
    for fn in summary.get("fns", []):
        fn_id = fn.get("id")
        if not fn_id:
            continue
        try:
            one = _rust_cli_json(["dec-fn", str(p), fn_id, "--tier", args.tier])
        except Exception as e:
            print(f"[dec] skip {fn_id}: {e}", file=sys.stderr)
            continue
        safe = fn_id.replace(":", "_").replace("/", "_")
        (fns_dir / f"{safe}.md").write_text(one.get("markdown", ""), encoding="utf-8")
    print(f"[dec] wrote: {dec_dir}", file=sys.stderr)
    print(f"  summary: {dec_dir / 'summary.md'}", file=sys.stderr)
    print(f"  fns:     {len(list(fns_dir.glob('*.md')))} files in {fns_dir}/", file=sys.stderr)
    return 0


