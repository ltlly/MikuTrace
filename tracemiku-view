#!/usr/bin/env python3
"""Deprecated shim for `./tracemiku view`.

The old Python TUI has been removed. Keep this launcher only so older shell
aliases still open the Rust v2 web viewer.
"""
import os, sys, pathlib

HERE = pathlib.Path(__file__).resolve().parent
os.execv(str(HERE / "tracemiku"), [str(HERE / "tracemiku"), "view", *sys.argv[1:]])
